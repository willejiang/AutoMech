# secrets — never commit
.env
*.key

# sim outputs
**/out/
**/frames/
**/meshes/
*.usd
*.usdc

# python
__pycache__/
*.pyc
.venv/
venv/

# videos + test assets (large)
videos/
*.mp4
!assets/AutoMech1.mp4
cassie_description/
anymal_c_simple_description/
loop_*/
out_*/

# maker2 run artifacts
output/
e2e_verify/
e2e_verify_run.log
maker2/**/__pycache__/

# maker2 KB: commit the curated indices (small, regenerable via
# `python -m maker2.kb.ingest`) but NOT the growing per-run memory indices,
# which are machine-local runtime state accumulated on passing runs.
maker2/kb/index/memory_*/
maker2/kb/index/analyzer/
