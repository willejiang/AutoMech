maker2/**/__pycache__/

# maker2 KB: commit the curated indices (small, regenerable via
# `python -m maker2.kb.ingest`) but NOT the growing per-run memory indices,
# which are machine-local runtime state accumulated on passing runs.
maker2/kb/index/memory_*/
maker2/kb/index/analyzer/

# Your own reference material for the KB. The committed corpus/ stays first-party and
# license-clean; whatever you are personally allowed to read goes here and is ingested
# into the same index without ever entering the repository. See its README.md.
maker2/kb/corpus_local/

# node (root automech app + worker)
node_modules/
dist/
.nitro/
.tanstack/
.output/
*.tsbuildinfo
src/routeTree.gen.ts
.automech/

# The cadam fork the UI grew out of. Untracked, not deleted: the app now lives at
# the repo root (src/), and worker/ is kept on disk only as a local reference.
worker/
