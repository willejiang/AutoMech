<mujoco model="open_single_stage_4to1">
  <compiler angle="radian" meshdir="meshes" autolimits="true" />
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" />
  <size njmax="2000" nconmax="400" />
  <default>
    <joint damping="0.02" armature="0.001" />
    <geom condim="3" friction="0.7 0.1 0.01" density="780" margin="0.0002" />
    <default class="visualmesh"><geom type="mesh" contype="0" conaffinity="0" rgba="0.58 0.67 0.72 1" /></default>
    <default class="collision"><geom contype="1" conaffinity="1" rgba="0.4 0.45 0.48 0.15" /></default>
  </default>
  <asset>
    <mesh name="base_mesh" file="base.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_support_front_mesh" file="input_support_front.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_support_rear_mesh" file="input_support_rear.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_support_front_mesh" file="output_support_front.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_support_rear_mesh" file="output_support_rear.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_bearing_front_mesh" file="input_bearing_front.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_bearing_rear_mesh" file="input_bearing_rear.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_bearing_front_mesh" file="output_bearing_front.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_bearing_rear_mesh" file="output_bearing_rear.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_shaft_mesh" file="input_shaft.stl" scale="0.001 0.001 0.001" />
    <mesh name="input_pinion_mesh" file="input_pinion.stl" scale="0.001 0.001 0.001" />
    <mesh name="hand_crank_arm_mesh" file="hand_crank_arm.stl" scale="0.001 0.001 0.001" />
    <mesh name="hand_crank_handle_mesh" file="hand_crank_handle.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_shaft_mesh" file="output_shaft.stl" scale="0.001 0.001 0.001" />
    <mesh name="output_gear_mesh" file="output_gear.stl" scale="0.001 0.001 0.001" />
  </asset>
  <worldbody>
    <geom name="ground" type="plane" size="0.3 0.3 0.01" contype="1" conaffinity="1" rgba="0.82 0.84 0.86 1" />
    <body name="base" pos="0 0 0">
      <geom class="visualmesh" name="base_visual" mesh="base_mesh" />
      <geom class="collision" name="base_collision" type="box" size="0.075 0.046 0.003" pos="0 0 0.003" />
      <body name="input_support_front"><geom class="visualmesh" mesh="input_support_front_mesh" /></body>
      <body name="input_support_rear"><geom class="visualmesh" mesh="input_support_rear_mesh" /></body>
      <body name="output_support_front"><geom class="visualmesh" mesh="output_support_front_mesh" /></body>
      <body name="output_support_rear"><geom class="visualmesh" mesh="output_support_rear_mesh" /></body>
      <body name="input_bearing_front"><geom class="visualmesh" mesh="input_bearing_front_mesh" /></body>
      <body name="input_bearing_rear"><geom class="visualmesh" mesh="input_bearing_rear_mesh" /></body>
      <body name="output_bearing_front"><geom class="visualmesh" mesh="output_bearing_front_mesh" /></body>
      <body name="output_bearing_rear"><geom class="visualmesh" mesh="output_bearing_rear_mesh" /></body>
    </body>
    <body name="input_shaft" pos="-0.045 0 0.072">
      <joint name="input_shaft_hinge" type="hinge" axis="0 1 0" />
      <geom class="collision" name="input_shaft_collision" type="cylinder" size="0.004 0.041" quat="0.70710678 0.70710678 0 0" />
      <geom class="visualmesh" name="input_shaft_visual" mesh="input_shaft_mesh" pos="0.045 0 -0.072" />
      <body name="input_pinion"><geom class="visualmesh" mesh="input_pinion_mesh" pos="0.045 0 -0.072" /></body>
      <body name="hand_crank">
        <body name="hand_crank_arm"><geom class="visualmesh" mesh="hand_crank_arm_mesh" pos="0.045 0 -0.072" /></body>
        <body name="hand_crank_handle"><geom class="visualmesh" mesh="hand_crank_handle_mesh" pos="0.045 0 -0.072" /></body>
      </body>
    </body>
    <body name="output_shaft" pos="0.045 0 0.072">
      <joint name="output_shaft_hinge" type="hinge" axis="0 1 0" />
      <geom class="collision" name="output_shaft_collision" type="cylinder" size="0.004 0.036" quat="0.70710678 0.70710678 0 0" />
      <geom class="visualmesh" name="output_shaft_visual" mesh="output_shaft_mesh" pos="-0.045 0 -0.072" />
      <body name="output_gear"><geom class="visualmesh" mesh="output_gear_mesh" pos="-0.045 0 -0.072" /></body>
    </body>
  </worldbody>
  <equality>
    <joint name="stage_1_ideal_gear_equality" joint1="output_shaft_hinge" joint2="input_shaft_hinge" polycoef="0 -0.25 0 0 0" solref="0.002 1" />
  </equality>
  <actuator>
    <position name="hand_crank_driver" joint="input_shaft_hinge" kp="80" kv="8" ctrlrange="-20 20" />
  </actuator>
</mujoco>