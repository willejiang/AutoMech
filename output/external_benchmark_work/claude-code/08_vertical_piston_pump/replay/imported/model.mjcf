<mujoco model="open_vertical_piston_pump">
  <compiler angle="radian" coordinate="local" meshdir="meshes" />
  <option timestep="0.002" gravity="0 0 0" integrator="implicitfast" iterations="80" />
  <size njmax="1000" nconmax="200" />
  <default>
    <joint damping="0.12" armature="0.001" />
    <geom condim="3" friction="0.7 0.03 0.01" density="1100" rgba="0.62 0.68 0.74 1" />
  </default>
  <asset>
    <mesh name="base_mesh" file="base.stl" scale="0.001 0.001 0.001" />
    <mesh name="left_bearing_mesh" file="left_bearing.stl" scale="0.001 0.001 0.001" />
    <mesh name="right_bearing_mesh" file="right_bearing.stl" scale="0.001 0.001 0.001" />
    <mesh name="guide_left_mesh" file="guide_left.stl" scale="0.001 0.001 0.001" />
    <mesh name="guide_right_mesh" file="guide_right.stl" scale="0.001 0.001 0.001" />
    <mesh name="cylinder_left_mesh" file="cylinder_left.stl" scale="0.001 0.001 0.001" />
    <mesh name="cylinder_right_mesh" file="cylinder_right.stl" scale="0.001 0.001 0.001" />
    <mesh name="crankshaft_mesh" file="crankshaft.stl" scale="0.001 0.001 0.001" />
    <mesh name="crank_disk_mesh" file="crank_disk.stl" scale="0.001 0.001 0.001" />
    <mesh name="hand_crank_mesh" file="hand_crank.stl" scale="0.001 0.001 0.001" />
    <mesh name="eccentric_pin_mesh" file="eccentric_pin.stl" scale="0.001 0.001 0.001" />
    <mesh name="connecting_rod_mesh" file="connecting_rod.stl" scale="0.001 0.001 0.001" />
    <mesh name="vertical_crosshead_mesh" file="vertical_crosshead.stl" scale="0.001 0.001 0.001" />
    <mesh name="pump_rod_mesh" file="pump_rod.stl" scale="0.001 0.001 0.001" />
    <mesh name="piston_mesh" file="piston.stl" scale="0.001 0.001 0.001" />
  </asset>
  <worldbody>
    <geom name="ground" type="plane" size="0.3 0.3 0.01" rgba="0.2 0.24 0.28 1" contype="0" conaffinity="0" />
    <body name="base"><geom type="mesh" mesh="base_mesh" contype="0" conaffinity="0" /></body>
    <body name="left_bearing"><geom type="mesh" mesh="left_bearing_mesh" contype="0" conaffinity="0" /></body>
    <body name="right_bearing"><geom type="mesh" mesh="right_bearing_mesh" contype="0" conaffinity="0" /></body>
    <body name="guide_left"><geom type="mesh" mesh="guide_left_mesh" contype="0" conaffinity="0" /></body>
    <body name="guide_right"><geom type="mesh" mesh="guide_right_mesh" contype="0" conaffinity="0" /></body>
    <body name="cylinder_left"><geom type="mesh" mesh="cylinder_left_mesh" contype="0" conaffinity="0" /></body>
    <body name="cylinder_right"><geom type="mesh" mesh="cylinder_right_mesh" contype="0" conaffinity="0" /></body>
    <body name="crankshaft" pos="0 0 0.075">
      <joint name="crankshaft_hinge" type="hinge" axis="1 0 0" />
      <geom name="crankshaft_geom" type="capsule" fromto="-0.036 0 0 0.036 0 0" size="0.006" mass="0.18" contype="0" conaffinity="0" />
      <body name="crank_disk" pos="-0.008 0 0"><geom type="cylinder" size="0.032 0.004" quat="0.7071068 0 0.7071068 0" mass="0.17" contype="0" conaffinity="0" /></body>
      <body name="hand_crank" pos="-0.044 0 0"><geom type="box" size="0.004 0.024 0.004" pos="0 0.020 0" mass="0.08" contype="0" conaffinity="0" /></body>
      <body name="eccentric_pin" pos="-0.008 0 0.018">
        <geom type="capsule" fromto="-0.009 0 0 0.009 0 0" size="0.005" mass="0.03" contype="0" conaffinity="0" />
        <site name="eccentric_pin_site" pos="0 0 0" size="0.002" />
        <body name="connecting_rod">
          <joint name="rod_crank_pin_hinge" type="hinge" axis="1 0 0" />
          <geom name="connecting_rod_geom" type="capsule" fromto="0 0 0 0 0 0.027" size="0.004" mass="0.07" contype="0" conaffinity="0" />
          <site name="rod_crosshead_site" pos="0 0 0.027" size="0.002" />
        </body>
      </body>
    </body>
    <body name="vertical_crosshead" pos="0 0 0.093">
      <joint name="crosshead_slide" type="slide" axis="0 0 1" range="0.008 0.046" limited="true" />
      <geom name="vertical_crosshead_geom" type="box" size="0.019 0.009 0.011" pos="0 0 0.027" mass="0.12" contype="0" conaffinity="0" />
      <site name="crosshead_pin_site" pos="-0.008 0 0.027" size="0.002" />
      <body name="pump_rod" pos="0 0 0.034">
        <geom name="pump_rod_geom" type="capsule" fromto="0 0 0 0 0 0.078" size="0.005" mass="0.08" contype="0" conaffinity="0" />
        <body name="piston" pos="0 0 0.083"><geom name="piston_geom" type="cylinder" size="0.016 0.007" mass="0.1" contype="1" conaffinity="1" /></body>
      </body>
    </body>
  </worldbody>
  <equality>
    <connect name="rod_crosshead_closure" site1="rod_crosshead_site" site2="crosshead_pin_site" active="false" />
  </equality>
  <actuator><position name="crankshaft_position_driver" joint="crankshaft_hinge" kp="900" kv="45" ctrlrange="-1000 1000" /></actuator>
</mujoco>