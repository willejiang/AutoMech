<mujoco model="four_planet_4to1_open_reducer">
  <compiler angle="radian" meshdir="meshes" autolimits="true" />
  <option timestep="0.005" gravity="0 0 0" integrator="implicitfast" iterations="80" />
  <default><joint armature="0.002" /><geom density="800" friction="0.6 0.05 0.001" /></default>
  <asset>
    <material name="base" rgba="0.25 0.28 0.32 1" /><material name="ring" rgba="0.68 0.70 0.73 1" />
    <material name="sun" rgba="0.95 0.70 0.12 1" /><material name="carrier" rgba="0.12 0.55 0.62 1" />
    <material name="crank" rgba="0.82 0.22 0.16 1" />
    <material name="planet0" rgba="0.90 0.48 0.10 1" /><material name="planet1" rgba="0.18 0.62 0.88 1" /><material name="planet2" rgba="0.34 0.78 0.42 1" /><material name="planet3" rgba="0.76 0.35 0.78 1" />
    <mesh name="base" file="base.stl" scale="0.001 0.001 0.001" /><mesh name="fixed_ring" file="fixed_ring.stl" scale="0.001 0.001 0.001" /><mesh name="sun_input" file="sun_input.stl" scale="0.001 0.001 0.001" /><mesh name="carrier_output" file="carrier_output.stl" scale="0.001 0.001 0.001" /><mesh name="hand_crank" file="hand_crank.stl" scale="0.001 0.001 0.001" /><mesh name="planet_gear_0" file="planet_gear_0.stl" scale="0.001 0.001 0.001" /><mesh name="planet_gear_1" file="planet_gear_1.stl" scale="0.001 0.001 0.001" /><mesh name="planet_gear_2" file="planet_gear_2.stl" scale="0.001 0.001 0.001" /><mesh name="planet_gear_3" file="planet_gear_3.stl" scale="0.001 0.001 0.001" /><mesh name="planet_pin_0" file="planet_pin_0.stl" scale="0.001 0.001 0.001" /><mesh name="planet_pin_1" file="planet_pin_1.stl" scale="0.001 0.001 0.001" /><mesh name="planet_pin_2" file="planet_pin_2.stl" scale="0.001 0.001 0.001" /><mesh name="planet_pin_3" file="planet_pin_3.stl" scale="0.001 0.001 0.001" />
  </asset>
  <worldbody>
    <light pos="0 -0.15 0.25" dir="0 0.5 -1" />
    <body name="base" pos="0 -0.1 -0.008"><geom name="base_geom" type="mesh" mesh="base" material="base" contype="1" conaffinity="1" /></body>
    <body name="fixed_ring"><geom name="fixed_ring_geom" type="mesh" mesh="fixed_ring" material="ring" contype="1" conaffinity="1" /></body>
    <body name="sun_input">
      <joint name="sun_hinge" type="hinge" axis="0 0 1" damping="0.05" />
      <geom name="sun_input_geom" type="mesh" mesh="sun_input" material="sun" contype="1" conaffinity="1" />
      <body name="hand_crank"><geom name="hand_crank_geom" type="mesh" mesh="hand_crank" material="crank" contype="1" conaffinity="1" /></body>
    </body>
    <body name="carrier_output" pos="0 0 -0.008">
      <joint name="carrier_hinge" type="hinge" axis="0 0 1" damping="0.05" />
      <geom name="carrier_output_geom" type="mesh" mesh="carrier_output" material="carrier" contype="1" conaffinity="1" />
      <body name="planet_pin_0" pos="0.048000000 0.000000000 0.008"><geom name="planet_pin_0_geom" type="mesh" mesh="planet_pin_0" material="carrier" contype="1" conaffinity="1" /></body><body name="planet_pin_1" pos="0.000000000 0.048000000 0.008"><geom name="planet_pin_1_geom" type="mesh" mesh="planet_pin_1" material="carrier" contype="1" conaffinity="1" /></body><body name="planet_pin_2" pos="-0.048000000 0.000000000 0.008"><geom name="planet_pin_2_geom" type="mesh" mesh="planet_pin_2" material="carrier" contype="1" conaffinity="1" /></body><body name="planet_pin_3" pos="-0.000000000 -0.048000000 0.008"><geom name="planet_pin_3_geom" type="mesh" mesh="planet_pin_3" material="carrier" contype="1" conaffinity="1" /></body>
      <body name="planet_gear_0" pos="0.048000000 0.000000000 0">
        <joint name="planet_hinge_0" type="hinge" axis="0 0 1" damping="0.02" />
        <geom name="planet_gear_0_geom" type="mesh" mesh="planet_gear_0" material="planet0" contype="1" conaffinity="1" />
      </body><body name="planet_gear_1" pos="0.000000000 0.048000000 0">
        <joint name="planet_hinge_1" type="hinge" axis="0 0 1" damping="0.02" />
        <geom name="planet_gear_1_geom" type="mesh" mesh="planet_gear_1" material="planet1" contype="1" conaffinity="1" />
      </body><body name="planet_gear_2" pos="-0.048000000 0.000000000 0">
        <joint name="planet_hinge_2" type="hinge" axis="0 0 1" damping="0.02" />
        <geom name="planet_gear_2_geom" type="mesh" mesh="planet_gear_2" material="planet2" contype="1" conaffinity="1" />
      </body><body name="planet_gear_3" pos="-0.000000000 -0.048000000 0">
        <joint name="planet_hinge_3" type="hinge" axis="0 0 1" damping="0.02" />
        <geom name="planet_gear_3_geom" type="mesh" mesh="planet_gear_3" material="planet3" contype="1" conaffinity="1" />
      </body>
    </body>
  </worldbody>
  <equality>
    <joint name="carrier_ratio_eq" joint1="carrier_hinge" joint2="sun_hinge" polycoef="0 -0.25 0 0 0" solref="0.0001 1" />
    <joint name="planet_spin_eq_0" joint1="planet_hinge_0" joint2="sun_hinge" polycoef="0 0.75 0 0 0" solref="0.0001 1" /><joint name="planet_spin_eq_1" joint1="planet_hinge_1" joint2="sun_hinge" polycoef="0 0.75 0 0 0" solref="0.0001 1" /><joint name="planet_spin_eq_2" joint1="planet_hinge_2" joint2="sun_hinge" polycoef="0 0.75 0 0 0" solref="0.0001 1" /><joint name="planet_spin_eq_3" joint1="planet_hinge_3" joint2="sun_hinge" polycoef="0 0.75 0 0 0" solref="0.0001 1" />
  </equality>
  <contact>
    <exclude body1="base" body2="fixed_ring" />
    <exclude body1="base" body2="sun_input" />
    <exclude body1="base" body2="carrier_output" />
    <exclude body1="sun_input" body2="hand_crank" />
    <exclude body1="carrier_output" body2="planet_pin_0" /><exclude body1="carrier_output" body2="planet_pin_1" /><exclude body1="carrier_output" body2="planet_pin_2" /><exclude body1="carrier_output" body2="planet_pin_3" />
    <exclude body1="planet_pin_0" body2="planet_gear_0" /><exclude body1="planet_pin_1" body2="planet_gear_1" /><exclude body1="planet_pin_2" body2="planet_gear_2" /><exclude body1="planet_pin_3" body2="planet_gear_3" />
    <exclude body1="sun_input" body2="planet_gear_0" /><exclude body1="sun_input" body2="planet_gear_1" /><exclude body1="sun_input" body2="planet_gear_2" /><exclude body1="sun_input" body2="planet_gear_3" />
    <exclude body1="fixed_ring" body2="planet_gear_0" /><exclude body1="fixed_ring" body2="planet_gear_1" /><exclude body1="fixed_ring" body2="planet_gear_2" /><exclude body1="fixed_ring" body2="planet_gear_3" />
  </contact>
  <actuator><position name="hand_driver" joint="sun_hinge" kp="400" kv="40" ctrllimited="true" ctrlrange="-20 20" /></actuator>
</mujoco>