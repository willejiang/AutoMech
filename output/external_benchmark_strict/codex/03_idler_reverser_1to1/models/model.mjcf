<mujoco model="open_idler_reverser_1to1">
 <compiler angle="radian" meshdir="meshes" /><option timestep=".002" integrator="implicitfast" /><default><joint damping=".02" armature=".0001" /><geom friction=".7 .01 .001" /></default>
 <asset>
  <mesh name="base_m" file="base.stl" scale=".001 .001 .001" /><mesh name="ifb_m" file="input_front_bearing.stl" scale=".001 .001 .001" /><mesh name="irb_m" file="input_rear_bearing.stl" scale=".001 .001 .001" /><mesh name="dfb_m" file="idler_front_bearing.stl" scale=".001 .001 .001" /><mesh name="drb_m" file="idler_rear_bearing.stl" scale=".001 .001 .001" /><mesh name="ofb_m" file="output_front_bearing.stl" scale=".001 .001 .001" /><mesh name="orb_m" file="output_rear_bearing.stl" scale=".001 .001 .001" />
  <mesh name="is_m" file="input_shaft.stl" scale=".001 .001 .001" /><mesh name="ds_m" file="idler_shaft.stl" scale=".001 .001 .001" /><mesh name="os_m" file="output_shaft.stl" scale=".001 .001 .001" /><mesh name="ig_m" file="input_gear.stl" scale=".001 .001 .001" /><mesh name="dg_m" file="idler_gear.stl" scale=".001 .001 .001" /><mesh name="og_m" file="output_gear.stl" scale=".001 .001 .001" /><mesh name="cr_m" file="hand_crank.stl" scale=".001 .001 .001" />
 </asset>
 <worldbody><geom name="ground" type="plane" size=".5 .5 .01" /><body name="base" pos="0 0 .004"><geom name="base_visual" type="mesh" mesh="base_m" contype="0" conaffinity="0" /><geom name="base_collision" type="box" size=".125 .05 .004" />
  <body name="input_front_bearing" pos="-.072 -.03 .086"><geom name="ifb_visual" type="mesh" mesh="ifb_m" contype="0" conaffinity="0" /></body><body name="input_rear_bearing" pos="-.072 .03 .086"><geom name="irb_visual" type="mesh" mesh="irb_m" contype="0" conaffinity="0" /></body>
  <body name="idler_front_bearing" pos="0 -.03 .086"><geom name="dfb_visual" type="mesh" mesh="dfb_m" contype="0" conaffinity="0" /></body><body name="idler_rear_bearing" pos="0 .03 .086"><geom name="drb_visual" type="mesh" mesh="drb_m" contype="0" conaffinity="0" /></body>
  <body name="output_front_bearing" pos=".072 -.03 .086"><geom name="ofb_visual" type="mesh" mesh="ofb_m" contype="0" conaffinity="0" /></body><body name="output_rear_bearing" pos=".072 .03 .086"><geom name="orb_visual" type="mesh" mesh="orb_m" contype="0" conaffinity="0" /></body>
  <body name="input_shaft" pos="-.072 0 .086"><joint name="input_shaft_hinge" type="hinge" axis="0 1 0" /><geom name="input_shaft_visual" type="mesh" mesh="is_m" contype="0" conaffinity="0" /><geom name="input_shaft_collision" type="cylinder" size=".005 .05" quat=".70710678 .70710678 0 0" /><body name="input_gear"><geom name="input_gear_visual" type="mesh" mesh="ig_m" contype="0" conaffinity="0" /></body><body name="hand_crank"><geom name="crank_visual" type="mesh" mesh="cr_m" contype="0" conaffinity="0" /></body></body>
  <body name="idler_shaft" pos="0 0 .086"><joint name="idler_shaft_hinge" type="hinge" axis="0 1 0" /><geom name="idler_shaft_visual" type="mesh" mesh="ds_m" contype="0" conaffinity="0" /><geom name="idler_shaft_collision" type="cylinder" size=".005 .04" quat=".70710678 .70710678 0 0" /><body name="idler_gear"><geom name="idler_gear_visual" type="mesh" mesh="dg_m" contype="0" conaffinity="0" /></body></body>
  <body name="output_shaft" pos=".072 0 .086"><joint name="output_shaft_hinge" type="hinge" axis="0 1 0" /><geom name="output_shaft_visual" type="mesh" mesh="os_m" contype="0" conaffinity="0" /><geom name="output_shaft_collision" type="cylinder" size=".005 .04" quat=".70710678 .70710678 0 0" /><body name="output_gear"><geom name="output_gear_visual" type="mesh" mesh="og_m" contype="0" conaffinity="0" /></body></body>
 </body></worldbody>
 <contact><exclude name="input_idler_exact_mesh" body1="input_gear" body2="idler_gear" /><exclude name="idler_output_exact_mesh" body1="idler_gear" body2="output_gear" /></contact>
 <equality><joint name="input_to_idler" joint1="idler_shaft_hinge" joint2="input_shaft_hinge" polycoef="0 -1 0 0 0" solref=".002 1" /><joint name="idler_to_output" joint1="output_shaft_hinge" joint2="idler_shaft_hinge" polycoef="0 -1 0 0 0" solref=".002 1" /></equality>
 <actuator><velocity name="hand_crank_velocity" joint="input_shaft_hinge" kv="4" ctrlrange="-8 8" /></actuator>
</mujoco>