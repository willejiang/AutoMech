<mujoco model="openwork_clock_12to1">
 <compiler angle="radian" meshdir="meshes" /><option timestep=".002" integrator="implicitfast" /><default><joint damping=".02" armature=".0001" /></default>
 <asset>
  <mesh name="base_m" file="base.stl" scale=".001 .001 .001" /><mesh name="cfb_m" file="central_front_bearing.stl" scale=".001 .001 .001" /><mesh name="crb_m" file="central_rear_bearing.stl" scale=".001 .001 .001" /><mesh name="ifb_m" file="intermediate_front_bearing.stl" scale=".001 .001 .001" /><mesh name="irb_m" file="intermediate_rear_bearing.stl" scale=".001 .001 .001" />
  <mesh name="minshaft_m" file="minute_input_shaft.stl" scale=".001 .001 .001" /><mesh name="hoursleeve_m" file="hour_output_sleeve.stl" scale=".001 .001 .001" /><mesh name="midshaft_m" file="intermediate_shaft.stl" scale=".001 .001 .001" /><mesh name="minpin_m" file="minute_input_pinion.stl" scale=".001 .001 .001" /><mesh name="s1g_m" file="stage1_intermediate_gear.stl" scale=".001 .001 .001" /><mesh name="s2p_m" file="stage2_intermediate_pinion.stl" scale=".001 .001 .001" /><mesh name="hg_m" file="hour_output_gear.stl" scale=".001 .001 .001" /><mesh name="mh_m" file="minute_hand.stl" scale=".001 .001 .001" /><mesh name="hh_m" file="hour_hand.stl" scale=".001 .001 .001" />
 </asset>
 <worldbody><geom name="ground" type="plane" size=".5 .5 .01" /><body name="base" pos="0 0 .004"><geom name="base_visual" type="mesh" mesh="base_m" contype="0" conaffinity="0" /><geom name="base_collision" type="box" size=".11 .05 .004" />
  <body name="central_front_bearing" pos=".045 -.028 .096"><geom name="cfb_visual" type="mesh" mesh="cfb_m" contype="0" conaffinity="0" /></body><body name="central_rear_bearing" pos=".045 .028 .096"><geom name="crb_visual" type="mesh" mesh="crb_m" contype="0" conaffinity="0" /></body><body name="intermediate_front_bearing" pos="-.027 -.028 .096"><geom name="ifb_visual" type="mesh" mesh="ifb_m" contype="0" conaffinity="0" /></body><body name="intermediate_rear_bearing" pos="-.027 .028 .096"><geom name="irb_visual" type="mesh" mesh="irb_m" contype="0" conaffinity="0" /></body>
  <body name="minute_input_shaft" pos=".045 0 .096"><joint name="minute_input_hinge" type="hinge" axis="0 1 0" /><geom name="minshaft_visual" type="mesh" mesh="minshaft_m" contype="0" conaffinity="0" /><geom name="minshaft_collision" type="cylinder" size=".004 .043" quat=".70710678 .70710678 0 0" /><body name="minute_input_pinion"><geom name="minpin_visual" type="mesh" mesh="minpin_m" contype="0" conaffinity="0" /></body><body name="minute_hand"><geom name="minute_hand_visual" type="mesh" mesh="mh_m" contype="0" conaffinity="0" /></body></body>
  <body name="hour_output_sleeve" pos=".045 0 .096"><joint name="hour_output_hinge" type="hinge" axis="0 1 0" /><geom name="hoursleeve_visual" type="mesh" mesh="hoursleeve_m" contype="0" conaffinity="0" /><geom name="hoursleeve_collision" type="cylinder" size=".007 .031" quat=".70710678 .70710678 0 0" /><body name="hour_output_gear"><geom name="hour_gear_visual" type="mesh" mesh="hg_m" contype="0" conaffinity="0" /></body><body name="hour_hand"><geom name="hour_hand_visual" type="mesh" mesh="hh_m" contype="0" conaffinity="0" /></body></body>
  <body name="intermediate_shaft" pos="-.027 0 .096"><joint name="intermediate_shaft_hinge" type="hinge" axis="0 1 0" /><geom name="midshaft_visual" type="mesh" mesh="midshaft_m" contype="0" conaffinity="0" /><geom name="midshaft_collision" type="cylinder" size=".005 .04" quat=".70710678 .70710678 0 0" /><body name="stage1_intermediate_gear"><geom name="s1g_visual" type="mesh" mesh="s1g_m" contype="0" conaffinity="0" /></body><body name="stage2_intermediate_pinion"><geom name="s2p_visual" type="mesh" mesh="s2p_m" contype="0" conaffinity="0" /></body></body>
 </body></worldbody>
 <contact><exclude name="stage1_exact_mesh" body1="minute_input_pinion" body2="stage1_intermediate_gear" /><exclude name="stage2_exact_mesh" body1="stage2_intermediate_pinion" body2="hour_output_gear" /></contact>
 <equality><joint name="minute_to_intermediate_3to1" joint1="intermediate_shaft_hinge" joint2="minute_input_hinge" polycoef="0 -.3333333333333333 0 0 0" solref=".002 1" /><joint name="intermediate_to_hour_4to1" joint1="hour_output_hinge" joint2="intermediate_shaft_hinge" polycoef="0 -.25 0 0 0" solref=".002 1" /></equality><actuator><velocity name="minute_input_velocity" joint="minute_input_hinge" kv="4" ctrlrange="-8 8" /></actuator>
</mujoco>