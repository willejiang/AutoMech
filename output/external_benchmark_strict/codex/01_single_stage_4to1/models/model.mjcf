  </contact>
  <equality>
    
    <joint name="spur_mesh_12t_to_48t" joint1="output_shaft_hinge" joint2="input_shaft_hinge" polycoef="0 -0.25 0 0 0" solref="0.002 1" />
  </equality>
  <actuator>
    
