ur_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"],fact_ids=["planetary_stage/four_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"])\n    for k in pd:\n        q=pd[k]\n        if q["action"]=="exclude": out.exclude(q["pair"][0],q["pair"][1],q["reason"],q["source_entity_ids"],q["fact_ids"])\n    for e in facts["entity_ids"]:\n        if e[:5]=="link/": out.decision(e,action="emitted",generated_nodes=[e[5:]],reason="Link emitted exactly once.",fact_ids=[e])\n        else: out.decision(e,action="represented_by",generated_nodes=["base"],reason="Entity represented by topology, equalities, contacts, or role map.",fact_ids=[e])\n', 'expected_revision': 5})
