[{"name":"input_shaft_to_sun","ratio":1.0},{"name":"four_to_one_planetary_stage","ratio":0.25}],"contact_decisions":contacts,"support_ground":"base rests on retained global ground","support_strategy":"fixed base tree supplies support"})\n    for n,p in tree:\n        out.body(n,p)\n        if n=="input_shaft": out.joint(n,"input_shaft_world_hinge",axis=(0,0,1),pos_mm=(0,0,0),frame="world")\n        if n=="carrier": out.joint(n,"carrier_world_hinge",axis=(0,0,1),pos_mm=(0,0,0),frame="world")\n        if n=="planet_gear_1": out.joint(n,"planet_1_carrier_hinge",axis=(0,0,1),pos_mm=(27,0,0),frame="world")\n        if n=="planet_gear_2": out.joint(n,"planet_2_carrier_hinge",axis=(0,0,1),pos_mm=(-13.5,23.3827,0),frame="world")\n        if n=="planet_gear_3": out.joint(n,"planet_3_carrier_hinge",axis=(0,0,1),pos_mm=(-13.5,-23.3827,0),frame="world")\n    out.joint_equality("eq_carrier","input_shaft_world_hinge","carrier_world_hinge",.25,reason="Fixed-ring 4:1 stage.",sources=["planetary_stage/four_to_one_planetary_stage"],fact_ids=["planetary_stage/four_to_one_planetary_stage"])\n    for i in (1,2,3): out.joint_equality("eq_p"+str(i),"carrier_world_hinge","planet_"+str(i)+"_carrier_hinge",-3,reason="Fixed-ring planet spin.",sources=["planetary_stage/four_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"],fact_ids=["planetary_stage/four_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"])\n    for k in pd:\n        q=pd[k]\n        if q["action"]=="exclude": out.exclude(q["pair"][0],q["pair"][1],q["reason"],q["source_entity_ids"],q["fact_ids"])\n    for e in facts["entity_ids"]:\n        if e[:5]=="link/": out.decision(e,action="emitted",generated_nodes=[e[5:]],reason="Link emitted exactly once.",fact_ids=[e])\n        else: out.decision(e,action="represented_by",generated_nodes=["base"],reason="Entity represented by emitted topology, equalities, contacts, or role map.",fact_ids=[e])\n', 'expected_revision': 2})
