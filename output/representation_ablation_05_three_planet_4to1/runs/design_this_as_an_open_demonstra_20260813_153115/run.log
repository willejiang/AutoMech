fixed_ring_gear"],\n        "planet_pin_2": ["planet_bushing_2","fixed_ring_gear","center_pedestal"],\n        "planet_pin_3": ["planet_bushing_3","fixed_ring_gear","center_pedestal"],\n        "planet_bushing_1": ["fixed_ring_gear"],\n        "planet_bushing_2": ["fixed_ring_gear","center_pedestal"],\n        "planet_bushing_3": ["fixed_ring_gear","center_pedestal"],\n        "input_crank": ["crank_handle","planet_bushing_1","fixed_ring_gear","planet_pin_1","planet_bushing_2","planet_bushing_3","planet_pin_2","planet_pin_3","carrier_bearing"],\n        "crank_handle": ["planet_gear_1"]\n    }\n    pd = {}\n    for a in adj:\n        for b in adj[a]:\n            x, y = (a,b) if a < b else (b,a)\n            pd[x+"|"+y] = {"pair":[x,y],"action":"keep","reason":"Measured nearby pair; positive three-axis AABB overlap or uncertain real overlap is retained unless an exact idealized interface applies.","source_entity_ids":["link/"+x,"link/"+y],"fact_ids":["nearby/"+x+"/"+y,"pair/"+x+"/"+y]}\n    extra = [("center_pedestal","input_bearing"),("center_pedestal","carrier_bearing")]\n    for a,b in extra:\n        x,y=(a,b) if a<b else (b,a)\n        pd[x+"|"+y]={"pair":[x,y],"action":"keep","reason":"Authored fit relation was investigated pair-specifically.","source_entity_ids":["link/"+x,"link/"+y],"fact_ids":["pair/"+x+"/"+y]}\n    false_pairs = [\n        ("base","input_shaft"),("input_shaft","planet_gear_1"),("input_shaft","planet_gear_2"),("input_shaft","planet_gear_3"),("input_shaft","output_indicator"),("input_shaft","planet_bushing_2"),("input_shaft","planet_bushing_3"),("input_shaft","planet_pin_2"),("input_shaft","planet_pin_3"),\n        ("carrier","sun_gear"),("sun_gear","planet_bushing_1"),("sun_gear","planet_bushing_2"),("sun_gear","planet_bushing_3"),("sun_gear","planet_pin_1"),("sun_gear","planet_pin_2"),("sun_gear","planet_pin_3"),("sun_gear","carrier_bearing"),("sun_gear","output_indicator"),("sun_gear","input_crank"),("sun_gear","center_pedestal"),("sun_gear","crank_handle"),("sun_gear","input_bearing"),("sun_gear","base"),\n        ("carrier","planet_gear_1"),("carrier","planet_gear_2"),("carrier","planet_gear_3"),("carrier","base"),("carrier","ring_post_1"),("carrier","ring_post_2"),("carrier","ring_post_3"),("carrier","crank_handle"),("carrier","input_crank"),\n        ("planet_gear_1","crank_handle"),("planet_gear_1","planet_gear_2"),("planet_gear_1","planet_gear_3"),("planet_gear_1","output_indicator"),("planet_gear_1","input_crank"),("planet_gear_1","carrier_bearing"),("planet_gear_1","center_pedestal"),("planet_gear_1","ring_post_1"),("planet_gear_1","input_bearing"),("planet_gear_1","planet_bushing_2"),("planet_gear_1","planet_bushing_3"),("planet_gear_1","base"),("planet_gear_1","planet_pin_2"),("planet_gear_1","planet_pin_3"),\n        ("planet_gear_2","carrier_bearing"),("planet_gear_2","input_crank"),("planet_gear_2","center_pedestal"),("planet_gear_2","output_indicator"),("planet_gear_2","ring_post_2"),("planet_gear_2","planet_gear_3"),("planet_gear_2","input_bearing"),("planet_gear_2","planet_bushing_1"),("planet_gear_2","base"),("planet_gear_2","planet_pin_1"),\n        ("planet_gear_3","carrier_bearing"),("planet_gear_3","input_crank"),("planet_gear_3","center_pedestal"),("planet_gear_3","output_indicator"),("planet_gear_3","ring_post_3"),("planet_gear_3","input_bearing"),("planet_gear_3","planet_bushing_1"),("planet_gear_3","base"),("planet_gear_3","planet_pin_1"),\n        ("output_indicator","carrier_bearing"),("output_indicator","ring_post_1"),("output_indicator","planet_bushing_1"),("output_indicator","fixed_ring_gear"),("output_indicator","input_bearing"),("output_indicator","base"),("output_indicator","crank_handle"),("output_indicator","input_crank"),\n        ("planet_pin_2","center_pedestal"),("planet_pin_3","center_pedestal"),("planet_bushing_2","center_pedestal"),("planet_bushing_3","center_pedestal"),("input_crank","planet_bushing_1"),("input_crank","fixed_ring_gear"),("input_crank","planet_pin_1"),("input_crank","planet_bushing_2"),("input_crank","planet_bushing_3"),("input_crank","planet_pin_2"),("input_crank","planet_pin_3"),("input_crank","carrier_bearing")\n    ]\n    for a,b in false_pairs:\n        x,y=(a,b) if a<b else (b,a)\n        q=pd[x+"|"+y]\n        q["action"]="exclude"\n        q["reason"]="Measured real surfaces are separated and at least one placed AABB overlap extent is zero; exclude this exact collision-proxy false-contact pair."\n    exact = [\n        ("center_pedestal","input_bearing","relation/input_bearing_in_pedestal","fit/center_pedestal/input_bearing_seat/input_bearing/outer_race","Declared press fit is rigidly carried."),\n        ("input_bearing","input_shaft","relation/input_shaft_lower_journal","fit/input_bearing/shaft_journal/input_shaft/lower_journal","Measured positive clearance journal is represented by the input hinge."),\n        ("input_shaft","sun_gear","relation/sun_to_input_shaft_press_fit","fit/input_shaft/sun_press_seat/sun_gear/shaft_bore","Measured interference press fit is rigidly carried."),\n        ("center_pedestal","carrier_bearing","relation/carrier_bearing_on_pedestal","fit/center_pedestal/carrier_bearing_seat/carrier_bearing/pedestal_bore","Measured clearance fit is represented in the fixed support topology."),\n        ("carrier_bearing","carrier","relation/carrier_on_central_bearing","fit/carrier_bearing/carrier_journal/carrier/central_bore","Declared journal is represented by the carrier hinge."),\n        ("planet_bushing_1","planet_gear_1","relation/planet_1_bushing_journal","fit/planet_bushing_1/gear_journal/planet_gear_1/bearing_bore","Declared planet journal is represented by the planet hinge."),\n        ("planet_bushing_2","planet_gear_2","relation/planet_2_bushing_journal","fit/planet_bushing_2/gear_journal/planet_gear_2/bearing_bore","Declared planet journal is represented by the planet hinge."),\n        ("planet_bushing_3","planet_gear_3","relation/planet_3_bushing_journal","fit/planet_bushing_3/gear_journal/planet_gear_3/bearing_bore","Declared planet journal is represented by the planet hinge."),\n        ("sun_gear","planet_gear_1","relation/sun_planet_1_mesh","fit/sun_gear/planet_mesh_1/planet_gear_1/sun_mesh","Exact authored tooth mesh is replaced by planetary equalities."),\n        ("sun_gear","planet_gear_2","relation/sun_planet_2_mesh","fit/sun_gear/planet_mesh_2/planet_gear_2/sun_mesh","Exact authored tooth mesh is replaced by planetary equalities."),\n        ("sun_gear","planet_gear_3","relation/sun_planet_3_mesh","fit/sun_gear/planet_mesh_3/planet_gear_3/sun_mesh","Exact authored tooth mesh is replaced by planetary equalities."),\n        ("fixed_ring_gear","planet_gear_1","planetary_stage/four_to_one_planetary_stage","fit/planet_gear_1/ring_mesh/fixed_ring_gear/internal_mesh_1","Exact planetary internal mesh is replaced by planetary equalities."),\n        ("fixed_ring_gear","planet_gear_2","planetary_stage/four_to_one_planetary_stage","fit/planet_gear_2/ring_mesh/fixed_ring_gear/internal_mesh_2","Exact planetary internal mesh is replaced by planetary equalities."),\n        ("fixed_ring_gear","planet_gear_3","planetary_stage/four_to_one_planetary_stage","fit/planet_gear_3/ring_mesh/fixed_ring_gear/internal_mesh_3","Exact planetary internal mesh is replaced by planetary equalities.")\n    ]\n    for a,b,s,f,r in exact:\n        x,y=(a,b) if a<b else (b,a)\n        q=pd[x+"|"+y]\n        q["action"]="exclude"; q["reason"]=r; q["source_entity_ids"]=[s]; q["fact_ids"]=[f,"pair/"+x+"/"+y]\n    contacts=[]\n    for k in pd:\n        contacts.append(pd[k])\n    cmap={"base":None,"center_pedestal":None,"input_bearing":None,"carrier_bearing":None,"input_shaft":"input_shaft_world_hinge","sun_gear":"input_shaft_world_hinge","carrier":"carrier_world_hinge","output_indicator":"carrier_world_hinge","planet_pin_1":"carrier_world_hinge","planet_pin_2":"carrier_world_hinge","planet_pin_3":"carrier_world_hinge","planet_bushing_1":"carrier_world_hinge","planet_bushing_2":"carrier_world_hinge","planet_bushing_3":"carrier_world_hinge","planet_gear_1":"planet_1_carrier_hinge","planet_gear_2":"planet_2_carrier_hinge","planet_gear_3":"planet_3_carrier_hinge","ring_post_1":None,"ring_post_2":None,"ring_post_3":None,"fixed_ring_gear":None,"input_crank":"input_shaft_world_hinge","crank_handle":"input_shaft_world_hinge"}\n    tree=[("base",""),("center_pedestal","base"),("input_bearing","center_pedestal"),("carrier_bearing","center_pedestal"),("ring_post_1","base"),("ring_post_2","base"),("ring_post_3","base"),("fixed_ring_gear","ring_post_1"),("input_shaft","input_bearing"),("sun_gear","input_shaft"),("input_crank","input_shaft"),("crank_handle","input_crank"),("carrier","carrier_bearing"),("output_indicator","carrier"),("planet_pin_1","carrier"),("planet_bushing_1","planet_pin_1"),("planet_pin_2","carrier"),("planet_bushing_2","planet_pin_2"),("planet_pin_3","carrier"),("planet_bushing_3","planet_pin_3"),("planet_gear_1","carrier"),("planet_gear_2","carrier"),("planet_gear_3","carrier")]\n    plan={"coordinate_map":cmap,"tree_edges":tree,"closure_edges":["eq_planetary_carrier","eq_planet_1","eq_planet_2","eq_planet_3"],"rigid_carried":[["input_shaft","sun_gear"],["input_shaft","input_crank"],["input_crank","crank_handle"],["carrier","output_indicator"],["carrier","planet_pin_1"],["carrier","planet_pin_2"],["carrier","planet_pin_3"],["carrier","planet_bushing_1"],["carrier","planet_bushing_2"],["carrier","planet_bushing_3"]],"independent_coaxial":[["input_shaft","carrier"]],"transmissions":[{"name":"input_shaft_to_sun","ratio":1.0,"strategy":"rigid press fit"},{"name":"four_to_one_planetary_stage","ratio":0.25,"strategy":"joint equalities"}],"contact_decisions":contacts,"support_ground":"base rests on global ground; ground retained","support_strategy":"Normal fixed base topology is already gravity-supported; no support patch is required."}\n    out.topology_plan(plan)\n    for n,p in tree:\n        out.body(n,p)\n        if n=="input_shaft": out.joint(n,"input_shaft_world_hinge",kind="hinge",axis=(0,0,1),pos_mm=(0,0,0),frame="world")\n        if n=="carrier": out.joint(n,"carrier_world_hinge",kind="hinge",axis=(0,0,1),pos_mm=(0,0,0),frame="world")\n        if n=="planet_gear_1": out.joint(n,"planet_1_carrier_hinge",kind="hinge",axis=(0,0,1),pos_mm=(27,0,0),frame="world")\n        if n=="planet_gear_2": out.joint(n,"planet_2_carrier_hinge",kind="hinge",axis=(0,0,1),pos_mm=(-13.5,23.3827,0),frame="world")\n        if n=="planet_gear_3": out.joint(n,"planet_3_carrier_hinge",kind="hinge",axis=(0,0,1),pos_mm=(-13.5,-23.3827,0),frame="world")\n    out.joint_equality("eq_planetary_carrier","input_shaft_world_hinge","carrier_world_hinge",0.25,reason="Fixed 54-tooth ring with 18-tooth sun gives carrier=(18/(18+54))*sun.",sources=["planetary_stage/four_to_one_planetary_stage"],fact_ids=["planetary_stage/four_to_one_planetary_stage"])\n    for i in (1,2,3):\n        out.joint_equality("eq_planet_"+str(i),"carrier_world_hinge","planet_"+str(i)+"_carrier_hinge",-3.0,reason="Fixed-ring planetary kinematics: local planet spin is -54/18 times carrier rotation.",sources=["planetary_stage/four_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"],fact_ids=["planetary_stage/four_to_one_planetary_stage","relation/sun_planet_"+str(i)+"_mesh"])\n    for k in pd:\n        q=pd[k]\n        if q["action"]=="exclude": out.exclude(q["pair"][0],q["pair"][1],q["reason"],q["source_entity_ids"],q["fact_ids"])\n    for e in facts["entity_ids"]:\n        if e[:5]=="link/": out.decision(e,action="emitted",generated_nodes=[e[5:]],reason="Immutable authored link emitted exactly once in the selected spanning tree.",fact_ids=[e])\n        else: out.decision(e,action="represented_by",generated_nodes=[],reason="Authored fact represented by the selected body tree, coordinates, planetary equalities, contact classification, or role map.",fact_ids=[e])\n', 'expected_revision': 0})
