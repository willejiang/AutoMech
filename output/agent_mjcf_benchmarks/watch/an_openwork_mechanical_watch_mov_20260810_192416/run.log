ss_fit','measured interference press fit, rigidly carried','fit/intermediate_pinion/bore/intermediate_arbor/shaft_axis'),\n      ('hour_wheel','hour_pipe'):('hour_wheel_press_fit','measured interference press fit, rigidly carried','fit/hour_wheel/bore/hour_pipe/outer_shaft'),\n      ('hour_hand','hour_pipe'):('hour_hand_press_fit','measured interference press fit, rigidly carried','fit/hour_hand/hub_bore/hour_pipe/hour_hand_seat'),\n      ('minute_hand','minute_pipe'):('minute_hand_press_fit','measured interference press fit, rigidly carried','fit/minute_hand/hub_bore/minute_pipe/minute_hand_seat'),\n      ('minute_pinion','intermediate_wheel'):('motion_work_stage_1','idealized external gear mesh represented by joint equality','fit/minute_pinion/teeth/intermediate_wheel/teeth'),\n      ('intermediate_pinion','hour_wheel'):('motion_work_stage_2','idealized external gear mesh represented by joint equality','fit/intermediate_pinion/teeth/hour_wheel/teeth')}\n    nearby = {\n      'minute_pipe':['baseplate','upper_bridge','central_lower_bearing','central_upper_bearing','hour_pipe','minute_pinion','hour_wheel','hour_hand','minute_hand','intermediate_wheel'],\n      'intermediate_arbor':['baseplate','upper_bridge','intermediate_lower_bearing','intermediate_upper_bearing','intermediate_wheel','intermediate_pinion','hour_wheel','hour_hand'],\n      'hour_pipe':['upper_bridge','central_upper_bearing','minute_pipe','minute_pinion','hour_wheel','hour_hand','minute_hand','intermediate_wheel','central_lower_bearing'],\n      'minute_pinion':['minute_pipe','hour_pipe','intermediate_wheel','hour_wheel','central_lower_bearing','upper_bridge','central_upper_bearing','baseplate'],\n      'intermediate_wheel':['pillar_03','pillar_04','intermediate_arbor','minute_pinion','hour_pipe','hour_wheel','intermediate_pinion','minute_pipe','central_lower_bearing','intermediate_lower_bearing','upper_bridge','central_upper_bearing','intermediate_upper_bearing','dial_marker_03','dial_marker_04','d