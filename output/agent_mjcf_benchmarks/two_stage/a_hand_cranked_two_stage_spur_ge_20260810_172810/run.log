, 'support_strategy':'weld baseplate to world only during gravity support probe'}\n    out.topology_plan(plan)\n    out.body('baseplate')\n    for n in ['front_left_column','rear_left_column','front_right_column','rear_right_column','upper_bridge','input_thrust_button','compound_thrust_button','output_thrust_button','input_lower_bearing','compound_lower_bearing','output_lower_bearing']:\n        out.body(n,'baseplate')\n    for n in ['input_upper_bearing','compound_upper_bearing','output_upper_bearing']:\n        out.body(n,'upper_bridge')\n    for s in ['input_shaft','compound_shaft','output_shaft']:\n        out.body(s,'baseplate')\n        out.joint(s,s+'_rotation',kind='hinge',axis=(0.0,0.0,1.0),pos_mm=(0.0,0.0,0.0))\n        for n in carried[s]:\n            out.body(n,s)\n    out.joint_equality('first_reduction','input_shaft_rotation','compound_shaft_rotation',polycoef=(0.0,-0.3333333333333333,0.0,0.0,0.0))\n    out.joint_equality('second_reduction','compound_shaft_rotation','output_shaft_rotation',polycoef=(0.0,-0.25,0.0,0.0,0.0))\n    exclusions = [\n      ('input_shaft','input_pinion',['relation/input_pinion_press_fit'],['pair/input_pinion/input_shaft']),\n      ('compound_shaft','compound_wheel',['relation/compound_wheel_press_fit'],['pair/compound_shaft/compound_wheel']),\n      ('compound_shaft','compound_pinion',['relation/compound_pinion_press_fit'],['pair/compound_pinion/compound_shaft']),\n      ('output_shaft','output_gear',['relation/output_gear_press_fit'],['pair/output_gear/output_shaft']),\n      ('input_shaft','hand_crank',['relation/crank_press_fit'],['pair/hand_crank/input_shaft']),\n      ('output_shaft','output_coupling',['relation/output_coupling_press_fit'],['pair/output_coupling/output_shaft']),\n      ('input_shaft','input_lower_bearing',['relation/input_lower_journal'],['fit/input_shaft/lower_journal/input_lower_bearing/journal','pair/input_lower_bearing/input_shaft']),\n      ('input_shaft','input_upper_bearing',['relation/input_upper_journal'],['fit/input_shaft/upper_journal/input_upper_bearing/journal','pair/input_shaft/input_upper_bearing']),\n      ('compound_shaft','compound_lower_bearing',['relation/compound_lower_journal'],['fit/compound_shaft/lower_journal/compound_lower_bearing/journal','pair/compound_lower_bearing/compound_shaft']),\n      ('compound_shaft','compound_upper_bearing',['relation/compound_upper_journal'],['fit/compound_shaft/upper_journal/compound_upper_bearing/journal','pair/compound_shaft/compound_upper_bearing']),\n      ('output_shaft','output_lower_bearing',['relation/output_lower_journal'],['fit/output_shaft/lower_journal/output_lower_bearing/journal','pair/output_lower_bearing/output_shaft']),\n      ('output_shaft','output_upper_bearing',['relation/output_upper_journal'],['fit/output_shaft/upper_journal/output_upper_bearing/journal','pair/output_shaft/output_upper_bearing']),\n      ('input_pinion','compound_wheel',['relation/stage_1_mesh'],['pair/compound_wheel/input_pinion']),\n      ('compound_pinion','output_gear',['relation/stage_2_mesh'],['pair/compound_pinion/output_gear'])]\n    for a,b,src,fids in exclusions:\n        out.exclude(a,b,'declared measured mechanical interface is represented kinematically',src,fids)\n    for eid in facts['entity_ids']:\n        out.decision(eid,'represented',[], 'entity represented by emitted body, joint, topology, equality, contact decision, or role mapping',[eid])\n    out.support_patch('weld','baseplate_support','Weld baseplate to world only for the gravity support probe because the base rests on the declared plane.')\n", 'expected_revision': 0})
