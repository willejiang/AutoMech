    <origin xyz="0.031103813166466276 0.0 0.004" rpy="0.0 -0.0 0.0"/>
  </joint>
  <joint name="place_wrist_pin" type="fixed">
    <parent link="slider"/>
    <child link="wrist_pin"/>
    <origin xyz="0.0 0.0 0.007" rpy="0.0 -0.0 0.0"/>
  </joint>
  <joint name="place_connecting_rod" type="fixed">
    <parent link="crank_pin"/>
