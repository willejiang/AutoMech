ion/output_gear_press_fit','fit/output_shaft/shaft_axis/output_gear/shaft_bore','pair/output_gear/output_shaft')]\n    meshes = [\n      ('input_pinion','intermediate_driven_gear','relation/stage1_physical_mesh','fit/input_pinion/stage1_mesh/intermediate_driven_gear/stage1_mesh','pair/input_pinion/intermediate_driven_gear'),\n      ('intermediate_stage2_pinion','output_gear','relation/stage2_physical_mesh','fit/intermediate_stage2_pinion/stage2_mesh/output_gear/stage2_mesh','pair/intermediate_stage2_pinion/output_gear')]\n    bearings = [('input_low_bearing','input_shaft','pair/input_low_bearing/input_shaft'),('input_high_bearing','input_shaft','pair/input_high_bearing/input_shaft'),('intermediate_low_bearing','intermediate_shaft','pair/intermediate_low_bearing/intermediate_shaft'),('intermediate_high_bearing','intermediate_shaft','pair/intermediate_high_bearing/intermediate_shaft'),('output_low_bearing','output_shaft','pair/output_low_bearing/output_shaft'),('output_high_bearing','output_shaft','pair/output_high_bearing/output_shaft')]\n    generic = [('input_shaft','intermediate_driven_gear'),('input_shaft','crank_grip'),('input_shaft','intermediate_stage2_pinion'),('input_shaft','crank_handle_spindle'),('crank_arm','intermediate_shaft'),('crank_handle_spindle','intermediate_shaft'),('intermediate_shaft','output_gear'),('crank_grip','intermediate_shaft'),('intermediate_driven_gear','output_shaft'),('input_low_bearing','input_pinion'),('input_high_bearing','input_pinion'),('crank_arm','input_pinion'),('input_pinion','intermediate_stage2_pinion'),('base','intermediate_driven_gear'),('intermediate_driven_gear','output_gear'),('intermediate_driven_gear','intermediate_stage2_pinion'),('input_low_bearing','intermediate_driven_gear'),('intermediate_low_bearing','intermediate_driven_gear'),('output_low_bearing','intermediate_driven_gear'),('input_high_bearing','intermediate_driven_gear'),('intermediate_high_bearing','intermediate_driven_gear'),('output_high_bearing','intermediate_driven_gear'),('crank_arm','intermediate_driven_gear'),('crank_handle_spindle','intermediate_driven_gear'),('crank_grip','intermediate_driven_gear'),('intermediate_high_bearing','intermediate_stage2_pinion'),('intermediate_high_bearing','output_gear'),('base','output_gear'),('output_high_bearing','output_gear'),('intermediate_low_bearing','output_gear'),('output_low_bearing','output_gear'),('crank_arm','output_gear'),('crank_handle_spindle','output_gear'),('crank_grip','output_gear'),('input_pinion','output_gear'),('input_high_bearing','output_gear'),('input_shaft','output_gear'),('input_low_bearing','output_gear'),('crank_arm','input_low_bearing'),('crank_arm','intermediate_low_bearing'),('crank_arm','crank_grip'),('base','crank_arm'),('crank_handle_spindle','intermediate_low_bearing'),('crank_grip','intermediate_low_bearing')]\n    cd = []\n    for a,b,r,f,p in press: cd.append({'pair':[a,b],'action':'exclude','reason':'Measured interference press fit is rigidly carried by one coordinate.','source_entity_ids':[r,'link/'+a,'link/'+b],'fact_ids':[f,p]})\n    for a,b,r,f,p in meshes: cd.append({'pair':[a,b],'action':'exclude','reason':'Tooth contact is replaced by an ideal gear equality.','source_entity_ids':[r,'link/'+a,'link/'+b],'fact_ids':[f,p]})\n    for a,b,p in bearings: cd.append({'pair':[a,b],'action':'exclude','reason':'Journal support is represented by the emitted hinge and must not resist spin.','source_entity_ids':['link/'+a,'link/'+b],'fact_ids':[p,'nearby/'+a+'/'+b]})\n    for a,b in generic:\n        x = a if a < b else b; y = b if a < b else a\n        cd.append({'pair':[a,b],'action':'exclude','reason':'Positive real-mesh separation or disjoint AABB extent proves proxy false-contact risk without contact function.','source_entity_ids':['link/'+a,'link/'+b],'fact_ids':['pair/'+x+'/'+y,'nearby/'+x+'/'+y]})\n    out.topology_plan({'coordinate_map':cmap,'tree_edges':[['','base'],['base','input_low_bearing'],['base','input_high_bearing'],['base','intermediate_low_bearing'],['base','intermediate_high_bearing'],['base','output_low_bearing'],['base','output_high_bearing'],['input_low_bearing','input_shaft'],['input_shaft','input_pinion'],['input_shaft','crank_arm'],['crank_arm','crank_handle_spindle'],['crank_handle_spindle','crank_grip'],['intermediate_low_bearing','intermediate_shaft'],['intermediate_shaft','intermediate_driven_gear'],['intermediate_shaft','intermediate_stage2_pinion'],['output_low_bearing','output_shaft'],['output_shaft','output_gear']],'closure_edges':[],'rigid_carried':[['input_shaft','input_pinion'],['input_shaft','crank_arm'],['crank_arm','crank_handle_spindle'],['crank_handle_spindle','crank_grip'],['intermediate_shaft','intermediate_driven_gear'],['intermediate_shaft','intermediate_stage2_pinion'],['output_shaft','output_gear']],'independent_coaxial':[],'transmissions':[{'driving_joint':'input_spin','driven_joint':'intermediate_spin','ratio':-0.3333333333333333},{'driving_joint':'intermediate_spin','driven_joint':'output_spin','ratio':-0.3333333333333333}],'contact_decisions':cd,'support_ground':True,'support_strategy':'Fixed base and bearing housings support three hinge coordinates; global ground remains enabled.'})\n    out.body('base')\n    for b in fixed[1:]: out.body(b,'base')\n    out.body('input_shaft','input_low_bearing'); out.joint('input_shaft','input_spin',kind='hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='local')\n    out.body('input_pinion','input_shaft'); out.body('crank_arm','input_shaft'); out.body('crank_handle_spindle','crank_arm'); out.body('crank_grip','crank_handle_spindle')\n    out.body('intermediate_shaft','intermediate_low_bearing'); out.joint('intermediate_shaft','intermediate_spin',kind='hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='local')\n    out.body('intermediate_driven_gear','intermediate_shaft'); out.body('intermediate_stage2_pinion','intermediate_shaft')\n    out.body('output_shaft','output_low_bearing'); out.joint('output_shaft','output_spin',kind='hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='local'); out.body('output_gear','output_shaft')\n    out.joint_equality('stage1_gear','input_spin','intermediate_spin',-0.3333333333333333,reason='External 4.8 to 14.4 mm pitch-radius mesh.',sources=['transmission/stage1_three_to_one','relation/stage1_physical_mesh'],fact_ids=['fit/input_pinion/stage1_mesh/intermediate_driven_gear/stage1_mesh','pair/input_pinion/intermediate_driven_gear'])\n    out.joint_equality('stage2_gear','intermediate_spin','output_spin',-0.3333333333333333,reason='External 4.8 to 14.4 mm pitch-radius mesh.',sources=['transmission/stage2_three_to_one','relation/stage2_physical_mesh'],fact_ids=['fit/intermediate_stage2_pinion/stage2_mesh/output_gear/stage2_mesh','pair/intermediate_stage2_pinion/output_gear'])\n    for d in cd: out.exclude(d['pair'][0],d['pair'][1],d['reason'],d['source_entity_ids'],d['fact_ids'])\n    for eid in facts['entity_ids']:\n        if eid.startswith('link/'):\n            out.decision(eid,action='emitted',generated_nodes=[eid[5:]],reason='Link mesh is emitted exactly once in the selected body tree.',fact_ids=[eid])\n        else:\n            out.decision(eid,action='represented_by',generated_nodes=['base'],reason='Authored placement, interface, port, transmission, or role is represented by the emitted machine topology.',fact_ids=[eid])\n", 'expected_revision': 1})
