[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    cm = {'input_shaft':'input_shaft_hinge','input_gear':'input_shaft_hinge','idler_shaft':'idler_shaft_hinge','idler_gear':'idler_shaft_hinge','output_shaft':'output_shaft_hinge','output_gear':'output_shaft_hinge','crank_arm':'input_shaft_hinge','crank_handle':'input_shaft_hinge'}\n    fixed = ['base','input_front_pedestal','input_front_bearing','input_rear_pedestal','input_rear_bearing','idler_front_pedestal','idler_front_bearing','idler_rear_pedestal','idler_rear_bearing','output_front_pedestal','output_front_bearing','output_rear_pedestal','output_rear_bearing']\n    for x in fixed:\n        cm[x] = None\n    rel = {\n      ('input_front_bearing','input_shaft'):('running journal fit (positive diametral clearance) is represented by the input hinge',['relation/input_front_journal'],['fit/input_front_bearing/journal/input_shaft/front_journal','pair/input_front_bearing/input_shaft','nearby/input_front_bearing/input_shaft']),\n      ('input_rear_bearing','input_shaft'):('running rear journal fit is represented by the same supported input hinge',['relation/input_rear_journal'],['fit/input_rear_bearing/journal/input_shaft/rear_journal','pair/input_rear_bearing/input_shaft','nearby/input_rear_bearing/input_shaft']),\n      ('idler_front_bearing','idler_shaft'):('running journal fit (positive diametral clearance) is represented by the idler hinge',['relation/idler_front_journal'],['fit/idler_front_bearing/journal/idler_shaft/front_journal','pair/idler_front_bearing/idler_shaft','nearby/idler_front_bearing/idler_shaft']),\n      ('idler_rear_bearing','idler_shaft'):('running rear journal fit is represented by the same supported idler hinge',['relation/idler_rear_journal'],['fit/idler_rear_bearing/journal/idler_shaft/rear_journal','pair/idler_rear_bearing/idler_shaft','nearby/idler_rear_bearing/idler_shaft']),\n      ('output_front_bearing','output_shaft'):('running journal fit (positive diametral clearance) is represented by the output hinge',['relation/output_front_journal'],['fit/output_front_bearing/journal/output_shaft/front_journal','pair/output_front_bearing/output_shaft','nearby/output_front_bearing/output_shaft']),\n      ('output_rear_bearing','output_shaft'):('running rear journal fit is represented by the same supported output hinge',['relation/output_rear_journal'],['fit/output_rear_bearing/journal/output_shaft/rear_journal','pair/output_rear_bearing/output_shaft','nearby/output_rear_bearing/output_shaft']),\n      ('input_gear','input_shaft'):('measured interference press fit is rigidly carried',['relation/input_gear_press_fit'],['fit/input_shaft/gear_seat/input_gear/shaft_bore','pair/input_gear/input_shaft','nearby/input_gear/input_shaft']),\n      ('idler_gear','idler_shaft'):('measured interference press fit is rigidly carried',['relation/idler_gear_press_fit'],['fit/idler_shaft/gear_seat/idler_gear/shaft_bore','pair/idler_gear/idler_shaft','nearby/idler_gear/idler_shaft']),\n      ('output_gear','output_shaft'):('measured interference press fit is rigidly carried',['relation/output_gear_press_fit'],['fit/output_shaft/gear_seat/output_gear/shaft_bore','pair/output_gear/output_shaft','nearby/output_gear/output_shaft']),\n      ('idler_gear','input_gear'):('ideal external gear equality replaces tooth contact',['relation/input_idler_mesh'],['fit/input_gear/mesh_to_idler/idler_gear/mesh_to_input','pair/idler_gear/input_gear','nearby/idler_gear/input_gear']),\n      ('idler_gear','output_gear'):('ideal external gear equality replaces tooth contact',['relation/idler_output_mesh'],['fit/idler_gear/mesh_to_output/output_gear/mesh_to_idler','pair/idler_gear/output_gear','nearby/idler_gear/output_gear']),\n      ('crank_arm','input_shaft'):('measured interference press fit is rigidly carried',['relation/crank_arm_press_fit'],['fit/input_shaft/crank_seat/crank_arm/shaft_bore','pair/crank_arm/input_shaft','nearby/crank_arm/input_shaft']),\n      ('crank_arm','crank_handle'):('measured interference press fit is rigidly carried',['relation/crank_handle_press_fit'],['fit/crank_arm/handle_bore/crank_handle/handle_shaft','pair/crank_arm/crank_handle','nearby/crank_arm/crank_handle'])}\n    false_pairs = [\n      ('input_front_pedestal','input_shaft'),('input_rear_pedestal','input_shaft'),('idler_gear','input_shaft'),('crank_handle','input_shaft'),\n      ('idler_front_pedestal','idler_shaft'),('idler_rear_pedestal','idler_shaft'),('idler_shaft','input_gear'),('idler_shaft','output_gear'),\n      ('output_front_pedestal','output_shaft'),('output_rear_pedestal','output_shaft'),('idler_gear','output_shaft'),\n      ('input_front_pedestal','input_gear'),('input_front_bearing','input_gear'),('input_gear','input_rear_bearing'),('input_gear','input_rear_pedestal'),('base','input_gear'),('idler_front_bearing','input_gear'),('idler_rear_bearing','input_gear'),('crank_arm','input_gear'),('crank_handle','input_gear'),('idler_front_pedestal','input_gear'),('idler_rear_pedestal','input_gear'),\n      ('base','idler_gear'),('idler_front_pedestal','idler_gear'),('idler_front_bearing','idler_gear'),('idler_gear','idler_rear_bearing'),('idler_gear','idler_rear_pedestal'),('idler_gear','input_front_bearing'),('idler_gear','output_front_bearing'),('idler_gear','input_rear_bearing'),('idler_gear','output_rear_bearing'),('idler_gear','input_front_pedestal'),('idler_gear','output_front_pedestal'),('idler_gear','input_rear_pedestal'),('idler_gear','output_rear_pedestal'),('crank_arm','idler_gear'),('crank_handle','idler_gear'),\n      ('output_front_pedestal','output_gear'),('output_front_bearing','output_gear'),('output_gear','output_rear_bearing'),('output_gear','output_rear_pedestal'),('base','output_gear'),('idler_front_bearing','output_gear'),('idler_rear_bearing','output_gear'),('idler_front_pedestal','output_gear'),('idler_rear_pedestal','output_gear'),('crank_arm','input_front_bearing'),('crank_arm','input_front_pedestal'),('base','crank_arm'),('crank_handle','input_front_bearing')]\n    for a,b in false_pairs:\n        p = tuple(sorted((a,b)))\n        if p not in rel:\n            rel[p] = ('placed real meshes have positive surface separation or disjoint AABB extent; exclude collision-proxy false contact',['link/'+a,'link/'+b],['pair/'+p[0]+'/'+p[1],'nearby/'+p[0]+'/'+p[1]])\n    contacts=[]\n    for p,v in rel.items():\n        contacts.append({'pair':[p[0],p[1]],'action':'exclude','reason':v[0],'source_entity_ids':v[1],'fact_ids':v[2]})\n    plan={'coordinate_map':cm,'tree_edges':[['base',x] for x in ['input_front_pedestal','input_rear_pedestal','idler_front_pedestal','idler_rear_pedestal','output_front_pedestal','output_rear_pedestal']]+[['input_front_pedestal','input_front_bearing'],['input_rear_pedestal','input_rear_bearing'],['idler_front_pedestal','idler_front_bearing'],['idler_rear_pedestal','idler_rear_bearing'],['output_front_pedestal','output_front_bearing'],['output_rear_pedestal','output_rear_bearing'],['input_front_bearing','input_shaft'],['idler_front_bearing','idler_shaft'],['output_front_bearing','output_shaft'],['input_shaft','input_gear'],['input_shaft','crank_arm'],['crank_arm','crank_handle'],['idler_shaft','idler_gear'],['output_shaft','output_gear']], 'closure_edges':[], 'rigid_carried':[['input_shaft','input_gear'],['idler_shaft','idler_gear'],['output_shaft','output_gear'],['input_shaft','crank_arm'],['crank_arm','crank_handle']], 'independent_coaxial':[], 'transmissions':[{'driving_joint':'input_shaft_hinge','driven_joint':'idler_shaft_hinge','ratio':-1.0},{'driving_joint':'idler_shaft_hinge','driven_joint':'output_shaft_hinge','ratio':-1.0}], 'contact_decisions':contacts, 'support_ground':'base rests on global ground plane', 'support_strategy':'fixed base and pedestal/bearing structure; support probe needs no topology alteration'}\n    out.topology_plan(plan)\n    parents={'base':'','input_front_pedestal':'base','input_front_bearing':'input_front_pedestal','input_rear_p