[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    # The crank train is a one-DOF closed slider-crank.  The rod hinge is in\n    # the spanning tree and its small end is the sole non-tree closure.\n    coord = {\n        'base': None, 'front_bearing_post': None, 'rear_bearing_post': None,\n        'front_bearing': None, 'rear_bearing': None,\n        'rotor_shaft': 'world_rotor_shaft_hinge',\n        'crank_disk': 'world_rotor_shaft_hinge', 'wind_rotor': 'world_rotor_shaft_hinge',\n        'crank_pin': 'world_rotor_shaft_hinge',\n        'connecting_rod': 'crank_big_end_hinge',\n        'left_guide_column': None, 'right_guide_column': None,\n        'left_guide_arm': None, 'right_guide_arm': None,\n        'left_guide': None, 'right_guide': None,\n        'crosshead': 'world_crosshead_vertical_slide',\n        'wrist_pin': 'world_crosshead_vertical_slide',\n        'pump_rod': 'world_crosshead_vertical_slide',\n        'pump_piston': 'world_crosshead_vertical_slide'\n    }\n    rel = {\n      ('front_bearing','rotor_shaft'):('relation/front_shaft_journal','fit/front_bearing/journal/rotor_shaft/shaft_axis'),\n      ('rear_bearing','rotor_shaft'):('relation/rear_shaft_journal','fit/rear_bearing/journal/rotor_shaft/shaft_axis'),\n      ('rotor_shaft','crank_disk'):('relation/shaft_carries_crank','fit/rotor_shaft/crank_seat/crank_disk/shaft_bore'),\n      ('rotor_shaft','wind_rotor'):('relation/shaft_carries_wind_rotor','fit/rotor_shaft/rotor_seat/wind_rotor/hub_bore'),\n      ('crank_disk','crank_pin'):('relation/crank_carries_eccentric_pin','fit/crank_disk/eccentric_pin_seat/crank_pin/pin_axis'),\n      ('crank_pin','connecting_rod'):('relation/crank_big_end_pin','fit/crank_pin/pin_axis/connecting_rod/big_end'),\n      ('crosshead','wrist_pin'):('relation/crosshead_carries_wrist_pin','fit/crosshead/wrist_bore/wrist_pin/pin_axis'),\n      ('wrist_pin','connecting_rod'):('relation/rod_small_end_closure','fit/wrist_pin/pin_axis/connecting_rod/small_end'),\n      ('crosshead','pump_rod'):('relation/crosshead_carries_pump_rod','fit/crosshead/pump_rod_seat/pump_rod/lower_end'),\n      ('pump_rod','pump_piston'):('relation/pump_rod_carries_piston','fit/pump_rod/upper_end/pump_piston/rod_bore')\n    }\n    keep = [\n      ('rotor_shaft','connecting_rod'), ('connecting_rod','base'),\n      ('connecting_rod','right_guide_arm'), ('connecting_rod','right_guide'),\n      ('connecting_rod','crosshead')\n    ]\n    false_gap = [\n      ('rotor_shaft','front_bearing_post'),('rotor_shaft','rear_bearing_post'),\n      ('rotor_shaft','crank_pin'),('rotor_shaft','right_guide_column'),\n      ('rotor_shaft','left_guide_column'),('rotor_shaft','right_guide_arm'),\n      ('rotor_shaft','left_guide_arm'),('rotor_shaft','right_guide'),('rotor_shaft','left_guide'),\n      ('crank_disk','connecting_rod'),('crank_disk','front_bearing_post'),\n      ('crank_disk','front_bearing'),('crank_disk','right_guide_column'),\n      ('crank_disk','left_guide_column'),('crank_disk','left_guide_arm'),\n      ('crank_disk','right_guide_arm'),('crank_disk','left_guide'),\n      ('crank_disk','right_guide'),('crank_disk','rear_bearing_post'),\n      ('crank_disk','rear_bearing'),('crank_disk','crosshead'),\n      ('wind_rotor','rear_bearing_post'),('wind_rotor','rear_bearing'),\n      ('wind_rotor','front_bearing_post'),('wind_rotor','front_bearing'),\n      ('wind_rotor','crank_disk'),('wind_rotor','left_guide_arm'),\n      ('wind_rotor','right_guide_arm'),('wind_rotor','left_guide'),\n      ('wind_rotor','right_guide'),('wind_rotor','crank_pin'),('wind_rotor','crosshead'),\n      ('wind_rotor','left_guide_column'),('wind_rotor','right_guide_column'),\n      ('wind_rotor','connecting_rod'),('wind_rotor','base'),('wind_rotor','wrist_pin'),\n      ('connecting_rod','left_guide'),('connecting_rod','left_guide_arm'),\n      ('connecting_rod','right_guide_column'),('connecting_rod','pump_rod'),\n      ('connecting_rod','front_bearing_post'),('connecting_rod','front_bearing'),\n      ('connecting_rod','left_guide_column'),('connecting_rod','rear_bearing_post'),\n      ('connecting_rod','rear_bearing'),('connecting_rod','pump_piston'),\n      ('crosshead','left_guide'),('crosshead','right_guide'),\n      ('crosshead','right_guide_arm'),('crosshead','left_guide_arm'),\n      ('wrist_pin','pump_rod'),('wrist_pin','left_guide'),('wrist_pin','right_guide'),\n      ('pump_rod','left_guide'),('pump_rod','right_guide')\n    ]\n    contacts=[]\n    for p in rel:\n        r,f=rel[p]\n        contacts.append({'pair':[p[0],p[1]],'action':'exclude','reason':'authored ideal rigid/running-fit or pin interface is represented by topology/closure, so contact must not fight it','source_entity_ids':[r,'link/'+p[0],'link/'+p[1]],'fact_ids':[f,'pair/'+('/'.join(sorted(p)))]})\n    for p in keep:\n        contacts.append({'pair':[p[0],p[1]],'action':'keep','reason':'placed AABBs overlap in all axes and solid intersection is unavailable; preserve uncertain real contact','source_entity_ids':['link/'+p[0],'link/'+p[1]],'fact_ids':['nearby/'+('/'.join(sorted(p))),'pair/'+('/'.join(sorted(p)))]})\n    for p in false_gap:\n        contacts.append({'pair':[p[0],p[1]],'action':'exclude','reason':'measured positive mesh separation with a disjoint AABB axis proves no real solid contact; exclude collision-proxy false contact','source_entity_ids':['link/'+p[0],'link/'+p[1]],'fact_ids':['nearby/'+('/'.join(sorted(p))),'pair/'+('/'.join(sorted(p)))]})\n    plan={'coordinate_map':coord,\n      'tree_edges':[['','rotor_shaft','world_rotor_shaft_hinge'],['crank_pin','connecting_rod','crank_big_end_hinge'],['','crosshead','world_crosshead_vertical_slide']],\n      'closure_edges':[['connecting_rod','wrist_pin','rod_small_end_connect']],\n      'rigid_carried':[['rotor_shaft','crank_disk'],['rotor_shaft','wind_rotor'],['crank_disk','crank_pin'],['crosshead','wrist_pin'],['crosshead','pump_rod'],['pump_rod','pump_piston']],\n      'independent_coaxial':[],\n      'transmissions':[{'name':'shaft_to_crank_rigid_carry','ratio':1.0},{'name':'shaft_to_wind_rotor_rigid_carry','ratio':1.0}],\n      'contact_decisions':contacts,'support_ground':['base'],\n      'support_strategy':'base remains fixed and is the structural gravity support; no support-probe patch is needed'}\n    out.topology_plan(plan)\n    fixed=[('base',''),('front_bearing_post','base'),('rear_bearing_post','base'),\n      ('front_bearing','front_bearing_post'),('rear_bearing','rear_bearing_post'),\n      ('left_guide_column','base'),('right_guide_column','base'),\n      ('left_guide_arm','left_guide_column'),('right_guide_arm','right_guide_column'),\n      ('left_guide','left_guide_arm'),('right_guide','right_guide_arm')]\n    for b,p in fixed: out.body(b,p)\n    out.body('rotor_shaft','')\n    out.joint('rotor_shaft','world_rotor_shaft_hinge','hinge',(0,1,0),(0,0,0),'world')\n    out.body('crank_disk','rotor_shaft'); out.body('wind_rotor','rotor_shaft')\n    out.body('crank_pin','crank_disk'); out.body('connecting_rod','crank_pin')\n    out.joint('connecting_rod','crank_big_end_hinge','hinge',(0,1,0),(12,-24.5,70),'world')\n    out.body('crosshead','')\n    out.joint('crosshead','world_crosshead_vertical_slide','slide',(0,0,1),(0,0,0),'world')\n    out.body('wrist_pin','crosshead'); out.body('pump_rod','crosshead'); out.body('pump_piston','pump_rod')\n    out.connect('rod_small_end_connect','connecting_rod','wrist_pin',(0,-0.0245,0.12),'small-end revolute closure of slider-crank',['relation/rod_small_end_closure'],['fit/wrist_pin/pin_axis/connecting_rod/small_end','pair/connecting_rod/wrist_pin'])\n    for p in rel:\n        r,f=rel[p]\n        out.exclude(p[0],p[1],'ideal authored fit/pin interface represented by rigid carrying, hinge, or closure',[r,'link/'+p[0],'link/'+p[1]],[f,'pair/'+('/'.join(sorted(p)))])\n    for p in false_gap:\n        out.exclude(p[0],p[1],'positive real-mesh separation and disjoint AABB axis: collision proxy false-contact risk',['link/'+p[0],'link/'+p[1]],['nearby/'+('/'.join(sorted(p))),'pair/'+('/'.join(sorted(p)))])\n    ids=['link/base','link/front_bearing_post','link/rear_bearing_post','link/front_bearing','link/rear_bearing','link/rotor_shaft','link/crank_disk','link/wind_rotor','link/crank_pin','link/connecting_rod','link/left_guide_column','link/right_guide_column','link/left_guide_arm','link/right_guide_arm','link/left_guide','link/right_guide','link/crosshead','link/wrist_pin','link/pump_rod','link/pump_piston']\n    ids += ['pose/place_'+x for x in ['base','front_bearing_post','rear_bearing_post','front_bearing','rear_bearing','rotor_shaft','crank_disk','wind_rotor','crank_pin','connecting_rod','left_guide_column','right_guide_column','left_guide_arm','right_guide_arm','left_guide','right_guide','crosshead','wrist_pin','pump_rod','pump_piston']]\n    ids += ['port/front_bearing/journal','port/rear_bearing/journal','port/rotor_shaft/shaft_axis','port/rotor_shaft/crank_seat','port/rotor_shaft/rotor_seat','port/crank_disk/shaft_bore','port/crank_disk/eccentric_pin_seat','port/wind_rotor/hub_bore','port/crank_pin/pin_axis','port/connecting_rod/big_end','port/connecting_rod/small_end','port/crosshead/wrist_bore','port/crosshead/vertical_slide','port/crosshead/pump_rod_seat','port/wrist_pin/pin_axis','port/pump_rod/lower_end','port/pump_rod/upper_end','port/pump_piston/rod_bore']\n    ids += ['relation/'+x for x in ['front_shaft_journal','rear_shaft_journal','shaft_carries_crank','shaft_carries_wind_rotor','crank_carries_eccentric_pin','crank_big_end_pin','crosshead_carries_wrist_pin','rod_small_end_closure','crosshead_carries_pump_rod','pump_rod_carries_piston']]\n    ids += ['motion_joint/world_rotor_shaft_hinge','motion_joint/world_crosshead_vertical_slide','transmission/shaft_to_crank_rigid_carry','transmission/shaft_to_wind_rotor_rigid_carry','role/driver/rotor_shaft','role/output/pump_rod','role/watch/rotor_shaft','role/watch/wind_rotor','role/watch/crank_disk','role/watch/connecting_rod','role/watch/crosshead','role/watch/pump_rod','role/watch/pump_piston']\n    for e in ids:\n        node='body/'+e[5:] if e[:5]=='link/' else ('joint/world_rotor_shaft_hinge' if ('rotor_shaft' in e or 'crank' in e or 'wind_rotor' in e) else 'joint/world_crosshead_vertical_slide')\n        out.decision(e,'emitted' if e[:5]=='link/' else 'represented_by',[node],'represented by the emitted body, coordinate, rigid carrying, fit exclusion, or closure',[e])\n", 'expected_revision': 0})
