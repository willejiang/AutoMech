[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    coord = {\n        'base': None, 'lower_bearing': None, 'upper_bearing': None,\n        'crankshaft': 'input_crankshaft_hinge',\n        'crank_disk': 'input_crankshaft_hinge',\n        'crank_pin': 'input_crankshaft_hinge',\n        'left_guide_rail': None, 'right_guide_rail': None,\n        'slider': 'horizontal_slider_joint',\n        'wrist_pin': 'horizontal_slider_joint',\n        'connecting_rod': 'crank_end_pin_hinge'\n    }\n    rows = [\n      ('base','crankshaft','exclude','zero-thickness AABB contact at the base top is a proxy false-contact risk',['link/base','link/crankshaft'],['pair/base/crankshaft','nearby/base/crankshaft']),\n      ('lower_bearing','crankshaft','exclude','measured clearance running journal is represented by the crank hinge',['relation/crankshaft_lower_revolute','port/lower_bearing/shaft_journal','port/crankshaft/lower_journal'],['fit/lower_bearing/shaft_journal/crankshaft/lower_journal','pair/crankshaft/lower_bearing','nearby/crankshaft/lower_bearing']),\n      ('upper_bearing','crankshaft','exclude','measured clearance upper journal supports but does not torque-couple the shaft',['relation/crankshaft_upper_journal','port/upper_bearing/shaft_journal','port/crankshaft/upper_journal'],['fit/upper_bearing/shaft_journal/crankshaft/upper_journal','pair/crankshaft/upper_bearing','nearby/crankshaft/upper_bearing']),\n      ('crank_disk','crankshaft','exclude','measured interference press fit is rigidly carried',['relation/disk_to_crankshaft_press_fit','transmission/crankshaft_to_disk_rigid_drive','port/crankshaft/disk_seat','port/crank_disk/shaft_bore'],['fit/crankshaft/disk_seat/crank_disk/shaft_bore','pair/crank_disk/crankshaft','nearby/crank_disk/crankshaft']),\n      ('connecting_rod','crankshaft','exclude','positive real-mesh separation and disjoint AABB extent show proxy false-contact risk',['link/connecting_rod','link/crankshaft'],['pair/connecting_rod/crankshaft','nearby/connecting_rod/crankshaft']),\n      ('crank_pin','crankshaft','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/crank_pin','link/crankshaft'],['pair/crank_pin/crankshaft','nearby/crank_pin/crankshaft']),\n      ('crank_disk','crank_pin','exclude','measured interference press fit is rigidly carried',['relation/eccentric_pin_to_disk_press_fit','port/crank_disk/eccentric_pin_bore','port/crank_pin/disk_press_seat'],['fit/crank_disk/eccentric_pin_bore/crank_pin/disk_press_seat','pair/crank_disk/crank_pin','nearby/crank_disk/crank_pin']),\n      ('crank_disk','upper_bearing','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/crank_disk','link/upper_bearing'],['pair/crank_disk/upper_bearing','nearby/crank_disk/upper_bearing']),\n      ('connecting_rod','crank_disk','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/connecting_rod','link/crank_disk'],['pair/connecting_rod/crank_disk','nearby/connecting_rod/crank_disk']),\n      ('crank_disk','lower_bearing','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/crank_disk','link/lower_bearing'],['pair/crank_disk/lower_bearing','nearby/crank_disk/lower_bearing']),\n      ('base','crank_disk','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/base','link/crank_disk'],['pair/base/crank_disk','nearby/base/crank_disk']),\n      ('crank_disk','left_guide_rail','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/crank_disk','link/left_guide_rail'],['pair/crank_disk/left_guide_rail','nearby/crank_disk/left_guide_rail']),\n      ('crank_disk','right_guide_rail','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/crank_disk','link/right_guide_rail'],['pair/crank_disk/right_guide_rail','nearby/crank_disk/right_guide_rail']),\n      ('connecting_rod','crank_pin','exclude','dedicated crank pin clearance journal is represented by the local hinge',['relation/crank_end_pin_closure','port/crank_pin/rod_journal','port/connecting_rod/big_end_bore'],['fit/crank_pin/rod_journal/connecting_rod/big_end_bore','pair/connecting_rod/crank_pin','nearby/connecting_rod/crank_pin']),\n      ('crank_pin','upper_bearing','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/crank_pin','link/upper_bearing'],['pair/crank_pin/upper_bearing','nearby/crank_pin/upper_bearing']),\n      ('crank_pin','lower_bearing','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/crank_pin','link/lower_bearing'],['pair/crank_pin/lower_bearing','nearby/crank_pin/lower_bearing']),\n      ('base','slider','exclude','zero-thickness AABB contact at the base top is replaced by the authored slide coordinate',['link/base','motion_joint/horizontal_slider_joint'],['pair/base/slider','nearby/base/slider']),\n      ('slider','wrist_pin','exclude','two measured interference press fits rigidly carry the wrist pin',['relation/lower_wrist_pin_press_fit','relation/upper_wrist_pin_press_fit','port/slider/lower_wrist_bore','port/slider/upper_wrist_bore','port/wrist_pin/lower_press_seat','port/wrist_pin/upper_press_seat'],['fit/slider/lower_wrist_bore/wrist_pin/lower_press_seat','fit/slider/upper_wrist_bore/wrist_pin/upper_press_seat','pair/slider/wrist_pin','nearby/slider/wrist_pin']),\n      ('connecting_rod','slider','exclude','positive real-mesh separation shows no contact-dependent function; closure uses wrist center',['link/connecting_rod','link/slider'],['pair/connecting_rod/slider','nearby/connecting_rod/slider']),\n      ('left_guide_rail','slider','exclude','positive real-mesh separation and disjoint lateral AABB extent; ideal slide supplies guidance',['link/left_guide_rail','motion_joint/horizontal_slider_joint'],['pair/left_guide_rail/slider','nearby/left_guide_rail/slider']),\n      ('right_guide_rail','slider','exclude','positive real-mesh separation and disjoint lateral AABB extent; ideal slide supplies guidance',['link/right_guide_rail','motion_joint/horizontal_slider_joint'],['pair/right_guide_rail/slider','nearby/right_guide_rail/slider']),\n      ('connecting_rod','wrist_pin','exclude','dedicated wrist pin clearance journal is represented by the point closure',['relation/slider_end_pin_closure','port/wrist_pin/rod_journal','port/connecting_rod/small_end_bore'],['fit/wrist_pin/rod_journal/connecting_rod/small_end_bore','pair/connecting_rod/wrist_pin','nearby/connecting_rod/wrist_pin']),\n      ('connecting_rod','upper_bearing','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/connecting_rod','link/upper_bearing'],['pair/connecting_rod/upper_bearing','nearby/connecting_rod/upper_bearing']),\n      ('connecting_rod','left_guide_rail','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/connecting_rod','link/left_guide_rail'],['pair/connecting_rod/left_guide_rail','nearby/connecting_rod/left_guide_rail']),\n      ('connecting_rod','right_guide_rail','exclude','positive real-mesh separation and disjoint AABB extents show proxy false-contact risk',['link/connecting_rod','link/right_guide_rail'],['pair/connecting_rod/right_guide_rail','nearby/connecting_rod/right_guide_rail']),\n      ('connecting_rod','lower_bearing','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/connecting_rod','link/lower_bearing'],['pair/connecting_rod/lower_bearing','nearby/connecting_rod/lower_bearing']),\n      ('base','connecting_rod','exclude','positive real-mesh separation and disjoint axial AABB extent show proxy false-contact risk',['link/base','link/connecting_rod'],['pair/base/connecting_rod','nearby/base/connecting_rod'])\n    ]\n    contacts = []\n    for a,b,act,why,src,fids in rows:\n        contacts.append({'pair':[a,b], 'action':act, 'reason':why, 'source_entity_ids':src, 'fact_ids':fids})\n    plan = {\n      'coordinate_map': coord,\n      'tree_edges': [['base','lower_bearing'],['base','upper_bearing'],['base','left_guide_rail'],['base','right_guide_rail'],['lower_bearing','crankshaft'],['crankshaft','crank_disk'],['crank_disk','crank_pin'],['crank_pin','connecting_rod'],['base','slider'],['slider','wrist_pin']],\n      'closure_edges': [{'name':'slider_end_pin_connect','between':['connecting_rod','wrist_pin'],'anchor_m':[0.05935381316646628,0.0,0.016]}],\n      'rigid_carried': [['crankshaft','crank_disk'],['crank_disk','crank_pin'],['slider','wrist_pin']],\n      'independent_coaxial': [['crankshaft','lower_bearing'],['crankshaft','upper_bearing'],['connecting_rod','crank_pin'],['connecting_rod','wrist_pin']],\n      'transmissions': [{'name':'crankshaft_to_disk_rigid_drive','type':'rigid_carry','ratio':1.0}],\n      'contact_decisions': contacts,\n      'support_ground': ['base'],\n      'support_strategy': 'fixed base and bearings support the normal mechanism; no support-probe alteration is required'\n    }\n    out.topology_plan(plan)\n    out.body('base')\n    out.body('lower_bearing','base')\n    out.body('upper_bearing','base')\n    out.body('left_guide_rail','base')\n    out.body('right_guide_rail','base')\n    out.body('crankshaft','lower_bearing')\n    out.joint('crankshaft','input_crankshaft_hinge',kind='hinge',axis=(0.0,0.0,1.0),pos_mm=(0.0,0.0,0.0),frame='world')\n    out.body('crank_disk','crankshaft')\n    out.body('crank_pin','crank_disk')\n    out.body('connecting_rod','crank_pin')\n    out.joint('connecting_rod','crank_end_pin_hinge',kind='hinge',axis=(0.0,0.0,1.0),pos_mm=(9.829824531467902,6.882917236212553,16.0),frame='world')\n    out.body('slider','base')\n    out.joint('slider','horizontal_slider_joint',kind='slide',axis=(1.0,0.0,0.0),pos_mm=(0.0,0.0,0.0),frame='world')\n    out.body('wrist_pin','slider')\n    out.connect('slider_end_pin_connect','connecting_rod','wrist_pin',(0.05935381316646628,0.0,0.016),'close the slider-crank at the measured wrist journal center',['relation/slider_end_pin_closure','port/wrist_pin/rod_journal','port/connecting_rod/small_end_bore'],['fit/wrist_pin/rod_journal/connecting_rod/small_end_bore','pair/connecting_rod/wrist_pin'])\n    for a,b,act,why,src,fids in rows:\n        if act == 'exclude':\n            out.exclude(a,b,why,src,fids)\n    ids = facts['entity_ids']\n    for eid in ids:\n        nodes = []\n        reason = 'authored fact represented in compiled topology'\n        if eid.startswith('link/'):\n            nodes = [eid[5:]]\n            action = 'emitted'\n        elif eid == 'motion_joint/input_crankshaft_hinge':\n            nodes = ['input_crankshaft_hinge']; action = 'emitted'\n        elif eid == 'motion_joint/horizontal_slider_joint':\n            nodes = ['horizontal_slider_joint']; action = 'emitted'\n        elif eid == 'relation/crank_end_pin_closure':\n            nodes = ['crank_end_pin_hinge']; action = 'represented_by'\n        elif eid == 'relation/slider_end_pin_closure':\n            nodes = ['slider_end_pin_connect']; action = 'represented_by'\n        elif eid == 'transmission/crankshaft_to_disk_rigid_drive':\n            nodes = ['crank_disk']; action = 'represented_by'\n        elif eid.startswith('role/'):\n            p = eid.split('/')[-1]; nodes = [coord[p]] if coord[p] else [p]; action = 'represented_by'\n        elif eid.startswith('pose/place_'):\n            nodes = [eid[11:]]; action = 'represented_by'\n        elif eid.startswith('port/'):\n            nodes = [eid.split('/')[1]]; action = 'represented_by'\n        elif eid.startswith('relation/'):\n            nodes = [eid[9:]]; action = 'represented_by'\n        else:\n            action = 'represented_by'\n        out.decision(eid,action=action,generated_nodes=nodes,reason=reason,fact_ids=[eid])\n", 'expected_revision': 0})
