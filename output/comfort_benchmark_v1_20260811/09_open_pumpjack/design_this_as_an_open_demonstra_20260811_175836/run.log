[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    coord = {'base':None,'negative_shaft_pedestal':None,'positive_shaft_pedestal':None,'negative_shaft_bearing':None,'positive_shaft_bearing':None,'crankshaft':'driven_crankshaft_hinge','crank_disk':'crank_disk_hinge','crank_pin':'crank_disk_hinge','pitman':'pitman_free','negative_beam_support':None,'positive_beam_support':None,'negative_pivot_bearing':None,'positive_pivot_bearing':None,'beam_pivot_pin':None,'walking_beam':'walking_beam_hinge','pitman_beam_pin':'walking_beam_hinge','beam_output_pin':'walking_beam_hinge','polished_output_rod':'vertical_guided_output','output_guide_post':None,'lower_output_guide':None,'upper_output_guide':None,'hand_crank_arm':'driven_crankshaft_hinge','handle_spindle':'driven_crankshaft_hinge','hand_grip':'driven_crankshaft_hinge'}\n    specs=[\n    ('crankshaft','negative_shaft_bearing','journal running fit represented by shaft hinge',['relation/shaft_in_negative_bearing'],['pair/crankshaft/negative_shaft_bearing','fit/negative_shaft_bearing/bearing_bore/crankshaft/rotation_axis','nearby/crankshaft/negative_shaft_bearing']),\n    ('crankshaft','positive_shaft_bearing','journal running fit represented by shaft hinge',['relation/shaft_in_positive_bearing'],['pair/crankshaft/positive_shaft_bearing','fit/positive_shaft_bearing/bearing_bore/crankshaft/rotation_axis','nearby/crankshaft/positive_shaft_bearing']),\n    ('crankshaft','crank_disk','press fit represented by 1:1 equality',['relation/disk_pressed_on_shaft','transmission/shaft_to_crank_disk_press_drive'],['pair/crank_disk/crankshaft','fit/crankshaft/disk_seat/crank_disk/shaft_bore','nearby/crank_disk/crankshaft']),\n    ('crank_disk','crank_pin','interference press fit rigidly carries pin',['relation/crank_pin_pressed_in_disk'],['pair/crank_disk/crank_pin','fit/crank_disk/crank_pin_seat/crank_pin/pin_shaft','nearby/crank_disk/crank_pin']),\n    ('crank_pin','pitman','dedicated clearance pin bearing represented by closure',['relation/crank_pin_to_pitman_closure'],['pair/crank_pin/pitman','fit/crank_pin/pin_shaft/pitman/crank_end_bore','nearby/crank_pin/pitman']),\n    ('pitman','pitman_beam_pin','dedicated clearance pin bearing represented by closure',['relation/pitman_to_walking_beam_closure'],['pair/pitman/pitman_beam_pin','fit/pitman_beam_pin/pin_shaft/pitman/beam_end_bore','nearby/pitman/pitman_beam_pin']),\n    ('walking_beam','beam_pivot_pin','clearance pivot represented by beam hinge',['relation/walking_beam_fixed_pivot'],['pair/beam_pivot_pin/walking_beam','fit/beam_pivot_pin/pivot_shaft/walking_beam/pivot_bore','nearby/beam_pivot_pin/walking_beam']),\n    ('walking_beam','pitman_beam_pin','measured interference rigidly carries dedicated pin',['link/walking_beam','link/pitman_beam_pin'],['pair/pitman_beam_pin/walking_beam','fit/pitman_beam_pin/pin_shaft/walking_beam/pitman_pin_bore','nearby/pitman_beam_pin/walking_beam']),\n    ('walking_beam','beam_output_pin','measured interference rigidly carries dedicated pin',['link/walking_beam','link/beam_output_pin'],['pair/beam_output_pin/walking_beam','fit/beam_output_pin/pin_shaft/walking_beam/output_pin_bore','nearby/beam_output_pin/walking_beam']),\n    ('polished_output_rod','beam_output_pin','dedicated clearance pin bearing represented by closure',['relation/beam_to_output_rod_closure'],['pair/beam_output_pin/polished_output_rod','fit/beam_output_pin/pin_shaft/polished_output_rod/beam_pin_bore','nearby/beam_output_pin/polished_output_rod']),\n    ('polished_output_rod','lower_output_guide','running guide represented by vertical slide',['link/polished_output_rod','link/lower_output_guide'],['pair/lower_output_guide/polished_output_rod','nearby/lower_output_guide/polished_output_rod']),\n    ('polished_output_rod','upper_output_guide','running guide represented by vertical slide',['link/polished_output_rod','link/upper_output_guide'],['pair/polished_output_rod/upper_output_guide','nearby/polished_output_rod/upper_output_guide'])]\n    false_pairs=[\n    ('crankshaft','pitman'),('crankshaft','negative_shaft_pedestal'),('crankshaft','positive_shaft_pedestal'),('crankshaft','crank_pin'),('crankshaft','hand_grip'),('crankshaft','handle_spindle'),('crankshaft','walking_beam'),('crankshaft','base'),('crankshaft','pitman_beam_pin'),\n    ('crank_disk','walking_beam'),('crank_disk','pitman'),('crank_disk','pitman_beam_pin'),('crank_disk','base'),('crank_disk','negative_shaft_pedestal'),('crank_disk','positive_shaft_pedestal'),('crank_disk','negative_shaft_bearing'),('crank_disk','positive_shaft_bearing'),('crank_disk','hand_crank_arm'),('crank_disk','handle_spindle'),('crank_disk','hand_grip'),('crank_disk','positive_beam_support'),('crank_disk','positive_pivot_bearing'),('crank_disk','negative_beam_support'),('crank_disk','negative_pivot_bearing'),\n    ('crank_pin','negative_shaft_bearing'),('pitman','walking_beam'),('pitman','negative_shaft_bearing'),('pitman','negative_shaft_pedestal'),\n    ('walking_beam','positive_beam_support'),('walking_beam','positive_pivot_bearing'),('walking_beam','negative_beam_support'),('walking_beam','negative_pivot_bearing'),('walking_beam','output_guide_post'),('walking_beam','crank_pin'),('walking_beam','upper_output_guide'),('walking_beam','hand_crank_arm'),('walking_beam','handle_spindle'),('walking_beam','hand_grip'),('walking_beam','lower_output_guide'),\n    ('polished_output_rod','base'),('polished_output_rod','output_guide_post'),('polished_output_rod','negative_pivot_bearing'),('polished_output_rod','positive_pivot_bearing'),('polished_output_rod','negative_beam_support'),('polished_output_rod','positive_beam_support'),('polished_output_rod','beam_pivot_pin')]\n    nearby={('crankshaft','pitman'):'nearby/crankshaft/pitman',('crankshaft','negative_shaft_pedestal'):'nearby/crankshaft/negative_shaft_pedestal',('crankshaft','positive_shaft_pedestal'):'nearby/crankshaft/positive_shaft_pedestal',('crankshaft','crank_pin'):'nearby/crank_pin/crankshaft',('crankshaft','hand_grip'):'nearby/crankshaft/hand_grip',('crankshaft','handle_spindle'):'nearby/crankshaft/handle_spindle',('crankshaft','walking_beam'):'nearby/crankshaft/walking_beam',('crankshaft','base'):'nearby/base/crankshaft',('crankshaft','pitman_beam_pin'):'nearby/crankshaft/pitman_beam_pin'}\n    raw=[]\n    for a,b,r,s,f in specs: raw.append((a,b,'exclude',r,s,f))\n    for a,b in false_pairs:\n        p='pair/'+a+'/'+b\n        n=nearby.get((a,b),'nearby/'+a+'/'+b)\n        raw.append((a,b,'exclude','positive real-mesh separation with a disjoint AABB overlap extent is a collision-proxy false-contact risk',['link/'+a,'link/'+b],[p,n]))\n    raw += [\n      ('crankshaft','hand_crank_arm','keep','uncertain measured overlap on rigid-carried accessory; policy keeps uncertain contact',['link/crankshaft','link/hand_crank_arm'],['pair/crankshaft/hand_crank_arm','nearby/crankshaft/hand_crank_arm']),\n      ('walking_beam','polished_output_rod','keep','output-joint solids meet and overlap is uncertain; retain possible real contact',['link/walking_beam','link/polished_output_rod'],['pair/polished_output_rod/walking_beam','nearby/polished_output_rod/walking_beam'])]\n    contacts=[{'pair':[a,b],'action':x,'reason':r,'source_entity_ids':s,'fact_ids':f} for a,b,x,r,s,f in raw]\n    tree=[['base','negative_shaft_pedestal'],['negative_shaft_pedestal','negative_shaft_bearing'],['base','positive_shaft_pedestal'],['positive_shaft_pedestal','positive_shaft_bearing'],['base','crankshaft'],['base','crank_disk'],['crank_disk','crank_pin'],['base','pitman'],['base','negative_beam_support'],['negative_beam_support','negative_pivot_bearing'],['base','positive_beam_support'],['positive_beam_support','positive_pivot_bearing'],['negative_pivot_bearing','beam_pivot_pin'],['base','walking_beam'],['walking_beam','pitman_beam_pin'],['walking_beam','beam_output_pin'],['base','polished_output_rod'],['base','output_guide_post'],['output_guide_post','lower_output_guide'],['output_guide