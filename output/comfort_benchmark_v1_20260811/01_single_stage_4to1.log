[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    coord = {\n        'base': None, 'bench_bolt_1': None, 'bench_bolt_2': None, 'bench_bolt_3': None, 'bench_bolt_4': None,\n        'input_thrust_washer': None, 'output_thrust_washer': None, 'input_bearing_pedestal': None,\n        'output_bearing_pedestal': None, 'input_lower_bearing': None, 'input_upper_bearing': None,\n        'output_lower_bearing': None, 'output_upper_bearing': None,\n        'input_shaft': 'input_shaft_hinge', 'input_pinion': 'input_shaft_hinge',\n        'hand_crank': 'input_shaft_hinge', 'output_shaft': 'output_shaft_hinge',\n        'output_gear': 'output_shaft_hinge', 'crank_grip': 'crank_grip_hinge'\n    }\n    rel = {\n        ('input_lower_bearing','input_shaft'): ('exclude','running journal fit is represented by the input shaft hinge',['relation/input_lower_running_fit','port/input_lower_bearing/journal','port/input_shaft/lower_journal'],['fit/input_lower_bearing/journal/input_shaft/lower_journal','pair/input_lower_bearing/input_shaft','nearby/input_lower_bearing/input_shaft']),\n        ('input_upper_bearing','input_shaft'): ('exclude','running journal fit is represented by the input shaft hinge',['relation/input_upper_running_fit','port/input_upper_bearing/journal','port/input_shaft/upper_journal'],['fit/input_upper_bearing/journal/input_shaft/upper_journal','pair/input_shaft/input_upper_bearing','nearby/input_shaft/input_upper_bearing']),\n        ('output_lower_bearing','output_shaft'): ('exclude','running journal fit is represented by the output shaft hinge',['relation/output_lower_running_fit','port/output_lower_bearing/journal','port/output_shaft/lower_journal'],['fit/output_lower_bearing/journal/output_shaft/lower_journal','pair/output_lower_bearing/output_shaft','nearby/output_lower_bearing/output_shaft']),\n        ('output_upper_bearing','output_shaft'): ('exclude','running journal fit is represented by the output shaft hinge',['relation/output_upper_running_fit','port/output_upper_bearing/journal','port/output_shaft/upper_journal'],['fit/output_upper_bearing/journal/output_shaft/upper_journal','pair/output_shaft/output_upper_bearing','nearby/output_shaft/output_upper_bearing']),\n        ('input_shaft','input_pinion'): ('exclude','measured interference press fit is rigidly carried',['relation/pinion_press_fit','port/input_shaft/pinion_seat','port/input_pinion/shaft_bore'],['fit/input_shaft/pinion_seat/input_pinion/shaft_bore','pair/input_pinion/input_shaft','nearby/input_pinion/input_shaft']),\n        ('output_shaft','output_gear'): ('exclude','measured interference press fit is rigidly carried',['relation/output_gear_press_fit','port/output_shaft/gear_seat','port/output_gear/shaft_bore'],['fit/output_shaft/gear_seat/output_gear/shaft_bore','pair/output_gear/output_shaft','nearby/output_gear/output_shaft']),\n        ('input_shaft','hand_crank'): ('exclude','measured interference press fit is rigidly carried',['relation/crank_press_fit','port/input_shaft/crank_seat','port/hand_crank/shaft_bore'],['fit/input_shaft/crank_seat/hand_crank/shaft_bore','pair/hand_crank/input_shaft','nearby/hand_crank/input_shaft']),\n        ('hand_crank','crank_grip'): ('exclude','running grip journal is represented by its hinge',['relation/crank_grip_running_fit','port/hand_crank/grip_pin','port/crank_grip/pin_bore'],['fit/hand_crank/grip_pin/crank_grip/pin_bore','pair/crank_grip/hand_crank','nearby/crank_grip/hand_crank']),\n        ('input_pinion','output_gear'): ('exclude','ideal joint equality replaces the external spur tooth mesh',['relation/stage1_external_spur_mesh','port/input_pinion/mesh','port/output_gear/mesh','transmission/spur_reduction_stage'],['fit/input_pinion/mesh/output_gear/mesh','pair/input_pinion/output_gear','nearby/input_pinion/output_gear'])\n    }\n    near = [\n      ('input_shaft','input_thrust_washer','keep'),('input_shaft','input_bearing_pedestal','exclude'),('input_shaft','output_gear','exclude'),('input_shaft','base','exclude'),\n      ('output_shaft','output_thrust_washer','keep'),('output_shaft','output_bearing_pedestal','exclude'),('output_shaft','base','exclude'),\n      ('input_pinion','input_upper_bearing','exclude'),('input_pinion','hand_crank','exclude'),('input_pinion','input_lower_bearing','exclude'),('input_pinion','input_bearing_pedestal','exclude'),('input_pinion','input_thrust_washer','exclude'),('input_pinion','base','exclude'),('input_pinion','crank_grip','exclude'),\n      ('output_gear','input_upper_bearing','exclude'),('output_gear','output_upper_bearing','exclude'),('output_gear','hand_crank','exclude'),('output_gear','input_lower_bearing','exclude'),('output_gear','output_lower_bearing','exclude'),('output_gear','crank_grip','exclude'),('output_gear','bench_bolt_3','exclude'),('output_gear','bench_bolt_4','exclude'),('output_gear','input_bearing_pedestal','exclude'),('output_gear','output_bearing_pedestal','exclude'),('output_gear','input_thrust_washer','exclude'),('output_gear','output_thrust_washer','exclude'),('output_gear','base','exclude'),('output_gear','bench_bolt_1','exclude'),('output_gear','bench_bolt_2','exclude'),\n      ('hand_crank','input_upper_bearing','exclude'),('hand_crank','input_lower_bearing','exclude'),('hand_crank','input_bearing_pedestal','exclude'),('hand_crank','input_thrust_washer','exclude'),('hand_crank','base','exclude')\n    ]\n    contacts = []\n    for p, v in rel.items():\n        contacts.append({'pair':[p[0],p[1]],'action':v[0],'reason':v[1],'source_entity_ids':v[2],'fact_ids':v[3]})\n    for a,b,act in near:\n        pf = 'pair/' + ('/'.join(sorted([a,b])))\n        nf = 'nearby/' + ('/'.join(sorted([a,b])))\n        reason = 'real thrust-face contact is mechanically required and geometry overlap is uncertain' if act == 'keep' else 'measured positive real-mesh separation or disjoint AABB makes this a collision-proxy false-contact risk'\n        contacts.append({'pair':[a,b],'action':act,'reason':reason,'source_entity_ids':['link/'+a,'link/'+b],'fact_ids':[pf,nf]})\n    plan = {\n      'coordinate_map':coord,\n      'tree_edges':[['base',x] for x in ['bench_bolt_1','bench_bolt_2','bench_bolt_3','bench_bolt_4','input_thrust_washer','output_thrust_washer','input_bearing_pedestal','output_bearing_pedestal','input_shaft','output_shaft']] + [['input_bearing_pedestal','input_lower_bearing'],['input_lower_bearing','input_upper_bearing'],['output_bearing_pedestal','output_lower_bearing'],['output_lower_bearing','output_upper_bearing'],['input_shaft','input_pinion'],['input_shaft','hand_crank'],['output_shaft','output_gear'],['hand_crank','crank_grip']],\n      'closure_edges':[['input_pinion','output_gear','joint_equality']],\n      'rigid_carried':[['input_shaft','input_pinion'],['input_shaft','hand_crank'],['output_shaft','output_gear']],\n      'independent_coaxial':[['input_shaft','input_lower_bearing'],['input_shaft','input_upper_bearing'],['output_shaft','output_lower_bearing'],['output_shaft','output_upper_bearing'],['hand_crank','crank_grip']],\n      'transmissions':[{'name':'spur_reduction_stage','driving_joint':'input_shaft_hinge','driven_joint':'output_shaft_hinge','ratio':-0.25}],\n      'contact_decisions':contacts,\n      'support_ground':['base'], 'support_strategy':'fixed base is the structural support and remains ground-collidable; no support patch is needed'\n    }\n    out.topology_plan(plan)\n    out.body('base')\n    fixed = ['bench_bolt_1','bench_bolt_2','bench_bolt_3','bench_bolt_4','input_thrust_washer','output_thrust_washer','input_bearing_pedestal','output_bearing_pedestal']\n    for x in fixed: out.body(x,'base')\n    out.body('input_lower_bearing','input_bearing_pedestal'); out.body('input_upper_bearing','input_lower_bearing')\n    out.body('output_lower_bearing','output_bearing_pedestal'); out.body('output_upper_bearing','output_lower_bearing')\n    out.body('input_shaft','base'); out.joint('input_shaft','input_shaft_hinge','hinge',(0,0,1),(0,0,0),'world')\n    out.body('input_pinion','input_shaft'); out.body('hand_crank','input_shaft')\n    out.body('crank_grip','hand_crank'); out.joint('crank_grip','crank_grip_hinge','hinge',(0,0,1),(0,0,0),'world')\n    out.body('output_shaft','base'); out.joint('output_shaft','output_shaft_hinge','hinge',(0,0,1),(0,0,0),'world')\n    out.body('output_gear','output_shaft')\n    out.joint_equality('spur_reduction_eq','input_shaft_hinge','output_shaft_hinge',-0.25,0.0,'external 9 mm to 36 mm pitch-radius spur reduction',['relation/stage1_external_spur_mesh','transmission/spur_reduction_stage'],['fit/input_pinion/mesh/output_gear/mesh','pair/input_pinion/output_gear'])\n    for c in contacts:\n        if c['action'] == 'exclude': out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n    ids = facts['entity_ids']\n    for e in ids:\n        nodes = []\n        action = 'represented_by'\n        if e[:5] == 'link/': nodes=[e[5:]]; action='emitted'\n        if e[:13] == 'motion_joint/': nodes=[e[13:]]; action='emitted'\n        out.decision(e,action,nodes,'authored entity is accounted for by the emitted body tree, coordinate mapping, fit exclusion, or transmission equality',[e])\n", 'expected_revision': 0})
