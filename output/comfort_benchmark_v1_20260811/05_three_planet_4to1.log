'/'+p[1]]\n                if k in rp:\n                    r = rp[k]; src.append('relation/'+r[0]); fids.append('fit/'+r[2]+'/'+r[3]+'/'+r[4]+'/'+r[5]); action='exclude'; reason='Exact authored '+r[1]+' interface is replaced by rigid carrying, a hinge, or ideal gear equality, so contact would fight it.'\n                elif k == 'base|input_shaft' or k == 'crank_grip|input_crank':\n                    action='keep'; reason='Measured surfaces touch and overlap is unavailable; preserve uncertain real contact.'\n                else:\n                    action='exclude'; reason='Positive real-mesh separation or disjoint AABB and no contact function identifies an exact collision-proxy false-contact risk.'\n                contacts.append({'pair':p,'action':action,'reason':reason,'source_entity_ids':src,'fact_ids':fids})\n    cm = {'base':None,'lower_input_bearing':None,'upper_input_bearing':None,'carrier_bearing':None,'ring_post_1':None,'ring_post_2':None,'ring_post_3':None,'fixed_ring':None,'input_shaft':'sun_input_hinge','sun_gear':'sun_input_hinge','input_crank':'sun_input_hinge','crank_grip':'sun_input_hinge','carrier':'carrier_output_hinge','planet_pin_1':'carrier_output_hinge','planet_pin_2':'carrier_output_hinge','planet_pin_3':'carrier_output_hinge','planet_1':'planet_1_carrier_hinge','planet_2':'planet_2_carrier_hinge','planet_3':'planet_3_carrier_hinge'}\n    tree = [['base','lower_input_bearing'],['base','upper_input_bearing'],['base','carrier_bearing'],['base','ring_post_1'],['base','ring_post_2'],['base','ring_post_3'],['base','fixed_ring'],['base','input_shaft'],['input_shaft','sun_gear'],['input_shaft','input_crank'],['input_crank','crank_grip'],['base','carrier'],['carrier','planet_pin_1'],['carrier','planet_pin_2'],['carrier','planet_pin_3'],['carrier','planet_1'],['carrier','planet_2'],['carrier','planet_3']]\n    out.topology_plan({'coordinate_map':cm,'tree_edges':tree,'closure_edges':[['sun_gear','carrier'],['sun_gear','planet_1'],['fixed_ring','planet_1'],['sun_gear','planet_2'],['fixed_ring','planet_2'],['sun_gear','planet_3'],['fixed_ring','planet_3']],'rigid_carried':[['input_shaft','sun_gear'],['input_shaft','input_crank'],['input_crank','crank_grip'],['carrier','planet_pin_1'],['carrier','planet_pin_2'],['carrier','planet_pin_3']],'independent_coaxial':[['input_shaft','carrier'],['sun_gear','carrier'],['sun_gear','fixed_ring']],'transmissions':[['sun_input_hinge','carrier_output_hinge',0.25],['sun_input_hinge','planet_1_carrier_hinge',-0.75],['sun_input_hinge','planet_2_carrier_hinge',-0.75],['sun_input_hinge','planet_3_carrier_hinge',-0.75]],'contact_decisions':contacts,'support_ground':['base'],'support_strategy':'Fixed base and structural supports remain ground-collidable; no support patch.'})\n    out.body('base')\n    for n in ['lower_input_bearing','upper_input_bearing','carrier_bearing','ring_post_1','ring_post_2','ring_post_3','fixed_ring']: out.body(n,'base')\n    out.body('input_shaft','base'); out.joint('input_shaft','sun_input_hinge',axis=(0,0,1),pos_mm=(0,0,18.2),frame='world')\n    out.body('sun_gear','input_shaft'); out.body('input_crank','input_shaft'); out.body('crank_grip','input_crank')\n    out.body('carrier','base'); out.joint('carrier','carrier_output_hinge',axis=(0,0,1),pos_mm=(0,0,13.5),frame='world')\n    for i in [1,2,3]: out.body('planet_pin_'+str(i),'carrier')\n    A=[(18,0,18.2),(-9,15.588457268119896,18.2),(-9,-15.588457268119893,18.2)]\n    for i in [1,2,3]:\n        q=str(i); out.body('planet_'+q,'carrier'); out.joint('planet_'+q,'planet_'+q+'_carrier_hinge',axis=(0,0,1),pos_mm=A[i-1],frame='world')\n    stage=['planetary_stage/four_to_one_planetary_stage']\n    out.joint_equality('planetary_carrier_ratio','sun_input_hinge','carrier_output_hinge',0.25,reason='Fixed 54-tooth ring and 18-tooth sun give 4:1 reduction.',sources=stage,fact_ids=stage)\n    for i in [1,2,3]:\n        q=str(i); s=['transmission/sun_to_planet_'+q,'transmission/planet_to_internal_ring_'+q,'planetary_stage/four_to_one_planetary_stage']; out.joint_equality('planetary_planet_ratio_'+q,'sun_input_hinge','planet_'+q+'_carrier_hinge',-0.75,reason='Planet local spin from the fixed-ring planetary kinematics.',sources=s,fact_ids=s)\n    for c in contacts:\n        if c['action']=='exclude': out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n    ids=[]\n    for n in links: ids.append('link/'+n); ids.append('pose/place_'+n)\n    ports=[('base','top'),('lower_input_bearing','journal'),('upper_input_bearing','journal'),('carrier_bearing','carrier_journal'),('input_shaft','shaft_axis'),('input_shaft','sun_seat'),('input_shaft','crank_seat'),('sun_gear','shaft_bore'),('sun_gear','sun_mesh'),('carrier','output_axis'),('carrier','pin_seat_1'),('carrier','pin_seat_2'),('carrier','pin_seat_3'),('fixed_ring','internal_mesh'),('input_crank','hub_bore'),('crank_grip','grip_axis'),('planet_1','pin_bore'),('planet_1','planet_mesh'),('planet_pin_1','pin_axis'),('planet_2','pin_bore'),('planet_2','planet_mesh'),('planet_pin_2','pin_axis'),('planet_3','pin_bore'),('planet_3','planet_mesh'),('planet_pin_3','pin_axis'),('ring_post_1','support_axis'),('ring_post_2','support_axis'),('ring_post_3','support_axis')]\n    for p in ports: ids.append('port/'+p[0]+'/'+p[1])\n    for r in rel: ids.append('relation/'+r[0])\n    joints=['sun_input_hinge','carrier_output_hinge','planet_1_carrier_hinge','planet_2_carrier_hinge','planet_3_carrier_hinge']\n    for j in joints: ids.append('motion_joint/'+j)\n    ts=['sun_to_planet_1','planet_to_internal_ring_1','sun_to_planet_2','planet_to_internal_ring_2','sun_to_planet_3','planet_to_internal_ring_3']\n    for t in ts: ids.append('transmission/'+t)\n    ids.append('planetary_stage/four_to_one_planetary_stage'); ids.append('role/driver/input_shaft'); ids.append('role/output/carrier')\n    for n in ['sun_gear','planet_1','planet_2','planet_3','carrier','input_crank']: ids.append('role/watch/'+n)\n    for e in ids:\n        nodes=[]; action='represented_by'\n        if e.startswith('link/'): nodes=[e[5:]]; action='emitted'\n        elif e.startswith('motion_joint/'): nodes=[e[13:]]; action='emitted'\n        elif e.startswith('transmission/'): nodes=['planetary_planet_ratio_'+e[-1]]\n        elif e.startswith('planetary_stage/'): nodes=['planetary_carrier_ratio','planetary_planet_ratio_1','planetary_planet_ratio_2','planetary_planet_ratio_3']\n        elif e=='role/driver/input_shaft' or e=='role/watch/sun_gear' or e=='role/watch/input_crank': nodes=['sun_input_hinge']\n        elif e=='role/output/carrier' or e=='role/watch/carrier': nodes=['carrier_output_hinge']\n        elif e.startswith('role/watch/planet_'): nodes=['planet_'+e[-1]+'_carrier_hinge']\n        elif e.startswith('relation/sun_planet_mesh_') or e.startswith('relation/ring_planet_mesh_'): nodes=['planetary_planet_ratio_'+e[-1]]\n        elif e=='relation/carrier_on_support_bearing' or e.startswith('relation/carrier_pin_press_fit_'): nodes=['carrier_output_hinge']\n        elif e.startswith('relation/planet_pin_journal_'): nodes=['planet_'+e[-1]+'_carrier_hinge']\n        elif e.startswith('relation/'): nodes=['sun_input_hinge']\n        out.decision(e,action=action,generated_nodes=nodes,reason='Represented by emitted topology, ideal coordinate, transmission, or contact classification.',fact_ids=[e])\n", 'expected_revision': 1})
