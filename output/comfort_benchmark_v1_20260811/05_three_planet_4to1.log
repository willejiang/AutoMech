ame='world')\n    for i in [1,2,3]:\n        out.body('planet_pin_'+str(i),'carrier')\n    A = [(18.0,0.0,18.2),(-9.0,15.588457268119896,18.2),(-9.0,-15.588457268119893,18.2)]\n    for i in [1,2,3]:\n        b = 'planet_'+str(i)\n        j = b+'_carrier_hinge'\n        out.body(b,'carrier')\n        out.joint(b,j,kind='hinge',axis=(0,0,1),pos_mm=A[i-1],frame='world')\n    stage = ['planetary_stage/four_to_one_planetary_stage']\n    out.joint_equality('planetary_carrier_ratio','sun_input_hinge','carrier_output_hinge',0.25,reason='Fixed 54-tooth ring and 18-tooth sun give carrier speed sun/(1+54/18).',sources=stage,fact_ids=stage)\n    for i in [1,2,3]:\n        q = str(i)\n        s = ['transmission/sun_to_planet_'+q,'transmission/planet_to_internal_ring_'+q,'planetary_stage/four_to_one_planetary_stage']\n        out.joint_equality('planetary_planet_ratio_'+q,'sun_input_hinge','planet_'+q+'_carrier_hinge',-0.75,reason='Equal-tooth external mesh with fixed 54-tooth internal ring gives local planet spin minus three quarters sun speed.',sources=s,fact_ids=s)\n    for c in contacts:\n        if c['action'] == 'exclude':\n            out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n    for e in facts['entity_ids']:\n        nodes = []\n        action = 'represented_by'\n        if e.startswith('link/'):\n            nodes = [e[5:]]\n            action = 'emitted'\n        elif e.startswith('motion_joint/'):\n            nodes = [e[13:]]\n            action = 'emitted'\n        elif e.startswith('transmission/sun_to_planet_'):\n            nodes = ['planetary_planet_ratio_'+e[-1]]\n        elif e.startswith('transmission/planet_to_internal_ring_'):\n            nodes = ['planetary_planet_ratio_'+e[-1]]\n        elif e.startswith('planetary_stage/'):\n            nodes = ['planetary_carrier_ratio','planetary_planet_ratio_1','planetary_planet_ratio_2','planetary_planet_ratio_3']\n        elif e == 'role/driver/input_shaft' or e == 'role/watch/sun_gear' or e == 'role/watch/input_crank':\n            nodes = ['sun_input_hinge']\n        elif e == 'role/output/carrier' or e == 'role/watch/carrier':\n            nodes = ['carrier_output_hinge']\n        elif e.startswith('role/watch/planet_'):\n            nodes = ['planet_'+e[-1]+'_carrier_hinge']\n        elif e.startswith('relation/sun_planet_mesh_') or e.startswith('relation/ring_planet_mesh_'):\n            nodes = ['planetary_planet_ratio_'+e[-1]]\n        elif e == 'relation/carrier_on_support_bearing' or e.startswith('relation/carrier_pin_press_fit_'):\n            nodes = ['carrier_output_hinge']\n        elif e.startswith('relation/planet_pin_journal_'):\n            nodes = ['planet_'+e[-1]+'_carrier_hinge']\n        elif e.startswith('relation/'):\n            nodes = ['sun_input_hinge']\n        out.decision(e,action=action,generated_nodes=nodes,reason='Authored entity is represented by the emitted body tree, coordinate, ideal transmission, or pair-specific contact classification.',fact_ids=[e])\n", 'expected_revision': 0})
