ent function; exclude this collision-proxy false-contact risk.'\n            action = 'exclude'\n        contacts.append({'pair':p,'action':action,'reason':reason,'source_entity_ids':src,'fact_ids':fids})\n    cm = {'input_shaft':'sun_input_hinge','sun_gear':'sun_input_hinge','input_crank':'sun_input_hinge','crank_grip':'sun_input_hinge','carrier':'carrier_output_hinge','planet_pin_1':'carrier_output_hinge','planet_pin_2':'carrier_output_hinge','planet_pin_3':'carrier_output_hinge','planet_1':'planet_1_carrier_hinge','planet_2':'planet_2_carrier_hinge','planet_3':'planet_3_carrier_hinge','fixed_ring':None}\n    for n in ['base','lower_input_bearing','upper_input_bearing','carrier_bearing','ring_post_1','ring_post_2','ring_post_3']:\n        cm[n] = None\n    plan = {'coordinate_map':cm,\n      'tree_edges':[['base','lower_input_bearing'],['base','upper_input_bearing'],['base','carrier_bearing'],['base','ring_post_1'],['base','ring_post_2'],['base','ring_post_3'],['base','fixed_ring'],['base','input_shaft'],['input_shaft','sun_gear'],['input_shaft','input_crank'],['input_crank','crank_grip'],['base','carrier'],['carrier','planet_pin_1'],['carrier','planet_pin_2'],['carrier','planet_pin_3'],['carrier','planet_1'],['carrier','planet_2'],['carrier','planet_3']],\n      'closure_edges':[['sun_gear','carrier'],['sun_gear','planet_1'],['fixed_ring','planet_1'],['sun_gear','planet_2'],['fixed_ring','planet_2'],['sun_gear','planet_3'],['fixed_ring','planet_3']],\n      'rigid_carried':[['input_shaft','sun_gear'],['input_shaft','input_crank'],['input_crank','crank_grip'],['carrier','planet_pin_1'],['carrier','planet_pin_2'],['carrier','planet_pin_3']],\n      'independent_coaxial':[['input_shaft','carrier'],['sun_gear','carrier'],['sun_gear','fixed_ring']],\n      'transmissions':[['sun_input_hinge','carrier_output_hinge',0.25],['sun_input_hinge','planet_1_carrier_hinge',-0.75],['sun_input_hinge','planet_2_carrier_hinge',-0.75],['sun_input_hinge','planet_3_carrier_hinge',-0.7