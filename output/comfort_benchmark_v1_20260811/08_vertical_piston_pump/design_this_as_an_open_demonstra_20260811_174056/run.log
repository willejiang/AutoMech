od:crankshaft','connecting_rod:crank_web']:\n            act='keep'; why='keep rod collision with shared shaft/web carrier solids; excluding it would hide non-journal interference'\n        else:\n            act='exclude'\n            if key in relation_pairs: why='exact measured press-fit or running journal interface is replaced by rigid carrying, hinge, or closure'\n            else: why='measured positive surface separation or disjoint AABB extent identifies collision-proxy false contact risk'\n            out.exclude(a,b,why,src,fid)\n        contact.append({'pair':[a,b],'action':act,'reason':why,'source_entity_ids':src,'fact_ids':fid})\n    fixed=['bench_base','rear_pedestal','rear_bearing','front_pedestal','front_bearing','left_guide_rail','right_guide_rail','cylinder_lower_frame','cylinder_left_post','cylinder_right_post','cylinder_upper_frame']\n    cm={}\n    for b in fixed: cm[b]=None\n    cm.update({'crankshaft':'crankshaft_revolute','crank_web':'crankshaft_revolute','crank_pin':'crankshaft_revolute','connecting_rod':'big_end_hinge','crosshead':'crosshead_vertical_slide','wrist_pin':'crosshead_vertical_slide','pump_rod':'crosshead_vertical_slide','pump_piston':'crosshead_vertical_slide','hand_crank_arm':'crankshaft_revolute','handle_pin':'crankshaft_revolute','hand_grip':'grip_hinge'})\n    out.topology_plan({'coordinate_map':cm,'tree_edges':bp,'closure_edges':[{'name':'small_end_closure','pair':['connecting_rod','wrist_pin']}],'rigid_carried':[['crankshaft','crank_web'],['crank_web','crank_pin'],['crosshead','wrist_pin'],['crosshead','pump_rod'],['pump_rod','pump_piston'],['crankshaft','hand_crank_arm'],['hand_crank_arm','handle_pin']],'independent_coaxial':[['rear_bearing','crankshaft'],['front_bearing','crankshaft'],['handle_pin','hand_grip']],'transmissions':[{'name':'shaft_rigidly_carries_crank_web','ratio':1.0},{'name':'crank_web_rigidly_carries_eccentric_pin','ratio':1.0},{'name':'shaft_rigidly_carries_hand_arm','ratio':1.0}],'contact_decisions':c