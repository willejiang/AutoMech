[tool] submit_compiler_source({'source': "def compile_mjcf(facts, out):\n    cm = {\n        'base':None,'minute_input_bearing':None,'intermediate_bearing':None,'rear_mast':None,\n        'lower_sleeve_bracket':None,'upper_sleeve_bracket':None,'sleeve_thrust_washer':None,\n        'lower_sleeve_bearing':None,'upper_sleeve_bearing':None,\n        'minute_shaft':'minute_spin','minute_gear':'minute_spin','minute_hand':'minute_spin',\n        'intermediate_shaft':'intermediate_spin','compound_big_gear':'intermediate_spin','compound_pinion':'intermediate_spin',\n        'hour_sleeve':'hour_spin','hour_gear':'hour_spin','hour_hand':'hour_spin'\n    }\n    tree = [\n        ['base',''],['minute_input_bearing','base'],['intermediate_bearing','base'],['rear_mast','base'],\n        ['lower_sleeve_bracket','rear_mast'],['upper_sleeve_bracket','rear_mast'],\n        ['sleeve_thrust_washer','lower_sleeve_bracket'],['lower_sleeve_bearing','lower_sleeve_bracket'],\n        ['upper_sleeve_bearing','upper_sleeve_bracket'],['minute_shaft','minute_input_bearing'],\n        ['minute_gear','minute_shaft'],['minute_hand','minute_shaft'],\n        ['intermediate_shaft','intermediate_bearing'],['compound_big_gear','intermediate_shaft'],\n        ['compound_pinion','intermediate_shaft'],['hour_sleeve','lower_sleeve_bearing'],\n        ['hour_gear','hour_sleeve'],['hour_hand','hour_sleeve']\n    ]\n    rel = {\n      ('minute_gear','compound_big_gear'):('relation/stage1_tooth_contact','fit/minute_gear/stage1_mesh/compound_big_gear/stage1_mesh','ideal external gear equality'),\n      ('compound_pinion','hour_gear'):('relation/stage2_tooth_contact','fit/hour_gear/stage2_mesh/compound_pinion/stage2_mesh','ideal external gear equality'),\n      ('minute_shaft','minute_gear'):('relation/minute_gear_press_fit','fit/minute_shaft/minute_gear_seat/minute_gear/shaft_bore','measured interference press fit'),\n      ('intermediate_shaft','compound_big_gear'):('relation/compound_big_press_fit','fit/intermediate_shaft/big_gear_seat/compound_big_gear/shaft_bore','measured interference press fit'),\n      ('intermediate_shaft','compound_pinion'):('relation/compound_pinion_press_fit','fit/intermediate_shaft/pinion_seat/compound_pinion/shaft_bore','measured interference press fit'),\n      ('hour_sleeve','hour_gear'):('relation/hour_gear_press_fit','fit/hour_sleeve/hour_gear_seat/hour_gear/sleeve_bore','measured interference press fit'),\n      ('minute_shaft','minute_hand'):('relation/minute_hand_press_fit','fit/minute_shaft/minute_hand_seat/minute_hand/hub_bore','measured interference press fit'),\n      ('hour_sleeve','hour_hand'):('relation/hour_hand_press_fit','fit/hour_sleeve/hour_hand_seat/hour_hand/hub_bore','measured interference press fit'),\n      ('minute_input_bearing','minute_shaft'):('relation/minute_lower_journal','fit/minute_input_bearing/journal_bore/minute_shaft/lower_journal','measured-clearance running journal represented by hinge'),\n      ('intermediate_bearing','intermediate_shaft'):('relation/intermediate_lower_journal','fit/intermediate_bearing/journal_bore/intermediate_shaft/lower_journal','measured-clearance running journal represented by hinge'),\n      ('lower_sleeve_bearing','hour_sleeve'):('relation/hour_sleeve_lower_journal','fit/lower_sleeve_bearing/journal_bore/hour_sleeve/lower_outer_journal','measured-clearance running journal represented by hinge'),\n      ('upper_sleeve_bearing','hour_sleeve'):('relation/hour_sleeve_upper_journal','fit/upper_sleeve_bearing/journal_bore/hour_sleeve/upper_outer_journal','measured-clearance running journal represented by hinge'),\n      ('minute_shaft','hour_sleeve'):('relation/independent_coaxial_handshaft_journal','fit/hour_sleeve/inner_journal/minute_shaft/sleeve_journal','measured-clearance independent coaxial journal')\n    }\n    raw = [\n      ('minute_shaft','base'),('minute_shaft','minute_input_bearing'),('minute_shaft','sleeve_thrust_washer'),\n      ('minute_shaft','lower_sleeve_bearing'),('minute_shaft','upper_sleeve_bearing'),('minute_shaft','hour_sleeve'),\n      ('minute_shaft','minute_gear'),('minute_shaft','hour_gear'),('minute_shaft','hour_hand'),('minute_shaft','minute_hand'),\n      ('minute_shaft','compound_big_gear'),('minute_shaft','lower_sleeve_bracket'),('minute_shaft','upper_sleeve_bracket'),\n      ('intermediate_shaft','base'),('intermediate_shaft','intermediate_bearing'),('intermediate_shaft','compound_big_gear'),\n      ('intermediate_shaft','compound_pinion'),('intermediate_shaft','hour_gear'),\n      ('hour_sleeve','sleeve_thrust_washer'),('hour_sleeve','lower_sleeve_bearing'),('hour_sleeve','upper_sleeve_bearing'),\n      ('hour_sleeve','hour_gear'),('hour_sleeve','hour_hand'),('hour_sleeve','minute_hand'),('hour_sleeve','minute_gear'),\n      ('hour_sleeve','compound_big_gear'),('hour_sleeve','lower_sleeve_bracket'),('hour_sleeve','upper_sleeve_bracket'),\n      ('hour_sleeve','minute_input_bearing'),('hour_sleeve','base'),\n      ('minute_gear','compound_big_gear'),('minute_gear','minute_input_bearing'),('minute_gear','sleeve_thrust_washer'),\n      ('minute_gear','lower_sleeve_bracket'),('minute_gear','lower_sleeve_bearing'),('minute_gear','base'),('minute_gear','hour_gear'),\n      ('compound_big_gear','minute_input_bearing'),('compound_big_gear','intermediate_bearing'),('compound_big_gear','sleeve_thrust_washer'),\n      ('compound_big_gear','lower_sleeve_bearing'),('compound_big_gear','lower_sleeve_bracket'),('compound_big_gear','base'),\n      ('compound_big_gear','rear_mast'),('compound_big_gear','compound_pinion'),('compound_big_gear','hour_gear'),\n      ('compound_big_gear','upper_sleeve_bearing'),('compound_big_gear','upper_sleeve_bracket'),('compound_big_gear','hour_hand'),\n      ('compound_big_gear','minute_hand'),('compound_pinion','hour_gear'),('compound_pinion','hour_hand'),\n      ('hour_gear','lower_sleeve_bracket'),('hour_gear','lower_sleeve_bearing'),('hour_gear','upper_sleeve_bracket'),\n      ('hour_gear','upper_sleeve_bearing'),('hour_gear','rear_mast'),('hour_gear','sleeve_thrust_washer'),('hour_gear','hour_hand'),\n      ('hour_gear','minute_hand'),('hour_gear','minute_input_bearing'),('hour_gear','intermediate_bearing'),('hour_gear','base'),\n      ('minute_hand','hour_hand'),('minute_hand','upper_sleeve_bearing'),('minute_hand','upper_sleeve_bracket'),\n      ('hour_hand','upper_sleeve_bracket'),('hour_hand','upper_sleeve_bearing')\n    ]\n    contacts=[]\n    seen=[]\n    for a,b in raw:\n        k=tuple(sorted([a,b]))\n        if k in seen: continue\n        seen.append(k)\n        rs=rel.get((a,b),rel.get((b,a)))\n        pf='pair/'+k[0]+'/'+k[1]\n        nf='nearby/'+k[0]+'/'+k[1]\n        if rs:\n            action='exclude'; reason=rs[2]; src=['link/'+a,'link/'+b,rs[0]]; fids=[rs[1],pf]\n        elif k==tuple(sorted(['hour_sleeve','sleeve_thrust_washer'])):\n            action='keep'; reason='real axial thrust interface is the accessory contact function'; src=['link/'+a,'link/'+b]; fids=[pf,nf]\n        else:\n            action='exclude'; reason='measured positive separation or disjoint AABB extent: collision-proxy false-contact risk with no contact function'; src=['link/'+a,'link/'+b]; fids=[pf,nf]\n        contacts.append({'pair':[a,b],'action':action,'reason':reason,'source_entity_ids':src,'fact_ids':fids})\n    plan={'coordinate_map':cm,'tree_edges':tree,'closure_edges':[],\n      'rigid_carried':[['minute_shaft','minute_gear'],['minute_shaft','minute_hand'],['intermediate_shaft','compound_big_gear'],['intermediate_shaft','compound_pinion'],['hour_sleeve','hour_gear'],['hour_sleeve','hour_hand']],\n      'independent_coaxial':[['minute_shaft','hour_sleeve']],\n      'transmissions':[{'name':'minute_to_compound_reduction','driving_joint':'minute_spin','driven_joint':'intermediate_spin','ratio':-0.3333333333333333},{'name':'rigid_compound_pair','coordinate':'intermediate_spin','ratio':1.0},{'name':'compound_to_hour_reduction','driving_joint':'intermedia