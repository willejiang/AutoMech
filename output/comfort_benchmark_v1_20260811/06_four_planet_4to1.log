/crank_arm'],['fit/input_shaft/crank_seat/crank_arm/drive_bore','pair/crank_arm/input_shaft']],\n 'crank_arm|crank_handle':['fixed accessory rigid carry',['link/crank_handle'],['pair/crank_arm/crank_handle']]}\n for i in range(1,5):\n  s=str(i)\n  ideal['planet_'+s+'|planet_pin_'+s]=['running journal hinge',['relation/planet_'+s+'_journal'],['fit/planet_pin_'+s+'/pin_shaft/planet_'+s+'/pin_bore','pair/planet_'+s+'/planet_pin_'+s]]\n  ideal['carrier|planet_pin_'+s]=['interference pin rigid carry',['link/planet_pin_'+s],['fit/carrier/pin_seat_'+s+'/planet_pin_'+s+'/pin_shaft','pair/carrier/planet_pin_'+s]]\n  ideal['planet_'+s+'|sun_gear']=['ideal external tooth mesh',['planetary_stage/four_planet_4to1_stage'],['fit/sun_gear/pitch_axis/planet_'+s+'/pitch_axis','pair/planet_'+s+'/sun_gear']]\n  ideal['fixed_ring_gear|planet_'+s]=['ideal internal tooth mesh',['planetary_stage/four_planet_4to1_stage'],['fit/fixed_ring_gear/ring_pitch_axis/planet_'+s+'/pitch_axis','pair/fixed_ring_gear/planet_'+s]]\n contacts=[]\n for p in pairs:\n  k=p[0]+'|'+p[1];r=p[1]+'|'+p[0]\n  if k in ideal:q=ideal[k]\n  elif r in ideal:q=ideal[r]\n  else:q=['positive mesh separation or disjoint AABB extent; no contact function',['link/'+p[0],'link/'+p[1]],['pair/'+p[0]+'/'+p[1]]]\n  contacts.append({'pair':p,'action':'exclude','reason':q[0],'source_entity_ids':q[1],'fact_ids':q[2]})\n cmap={'base':None,'input_bearing':None,'output_bearing':None,'fixed_ring_gear':None,'input_shaft':'input_shaft_hinge','sun_gear':'input_shaft_hinge','crank_arm':'input_shaft_hinge','crank_handle':'input_shaft_hinge','output_sleeve':'output_sleeve_hinge','carrier':'output_sleeve_hinge'}\n for i in range(1,5):cmap['planet_pin_'+str(i)]='output_sleeve_hinge';cmap['planet_'+str(i)]='planet_'+str(i)+'_carrier_hinge'\n out.topology_plan({'coordinate_map':cmap,'tree_edges':[['base','fixed'],['input_bearing','input_shaft'],['output_bearing','output_sleeve'],['carrier','planet pins'],['planet pins','planets']],'closure_edges':[['input','output'],['input','planets']],'rigid_carried':['sun/input','carrier/sleeve','pins/carrier','crank/input'],'independent_coaxial':['input/output','planet/carrier'],'transmissions':['carrier=sun/4','planet=-3sun/4'],'contact_decisions':contacts,'support_ground':'base on ground','support_strategy':'fixed root; no patch'})\n out.body('base')\n for b in ['input_bearing','output_bearing','ring_post_1','ring_post_2','ring_post_3','ring_post_4']:out.body(b,'base')\n out.body('fixed_ring_gear','ring_post_1');out.body('input_shaft','input_bearing');out.joint('input_shaft','input_shaft_hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world');out.body('sun_gear','input_shaft');out.body('crank_arm','input_shaft');out.body('crank_handle','crank_arm');out.body('output_sleeve','output_bearing');out.joint('output_sleeve','output_sleeve_hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world');out.body('carrier','output_sleeve')\n pp=[(16,0,0),(0,16,0),(-16,0,0),(0,-16,0)]\n for i in range(1,5):\n  s=str(i);out.body('planet_pin_'+s,'carrier');out.body('planet_'+s,'planet_pin_'+s);out.joint('planet_'+s,'planet_'+s+'_carrier_hinge',axis=(0,0,1),pos_mm=pp[i-1],frame='world')\n out.joint_equality('planetary_carrier_ratio','input_shaft_hinge','output_sleeve_hinge',.25,reason='fixed ring ratio',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n for i in range(1,5):\n  s=str(i);out.joint_equality('planet_'+s+'_mesh','input_shaft_hinge','planet_'+s+'_carrier_hinge',-.75,reason='planet mesh kinematics',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n for c in contacts:out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n nodes={'motion_joint/input_shaft_hinge':['input_shaft_hinge'],'motion_joint/sun_hinge':['input_shaft_hinge'],'motion_joint/carrier_hinge':['output_sleeve_hinge'],'motion_joint/output_sleeve_hinge':['output_sleeve_hinge'],'transmission