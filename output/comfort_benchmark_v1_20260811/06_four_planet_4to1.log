aring|planet_2 output_bearing|planet_2 crank_arm|planet_2 planet_2|ring_post_1 planet_2|ring_post_2 crank_handle|planet_2 base|planet_2 planet_3|planet_pin_2 planet_3|planet_pin_4 input_bearing|planet_3 output_bearing|planet_3 crank_arm|planet_3 planet_3|ring_post_2 planet_3|ring_post_3 base|planet_3 planet_4|planet_pin_3 planet_4|planet_pin_1 input_bearing|planet_4 output_bearing|planet_4 crank_arm|planet_4 planet_4|ring_post_3 planet_4|ring_post_4 crank_handle|planet_4 base|planet_4 fixed_ring_gear|planet_pin_1 crank_arm|planet_pin_1 fixed_ring_gear|planet_pin_2 fixed_ring_gear|planet_pin_3 fixed_ring_gear|planet_pin_4 crank_arm|crank_handle crank_arm|fixed_ring_gear crank_arm|planet_pin_2 crank_arm|planet_pin_3 crank_arm|planet_pin_4 crank_arm|output_sleeve crank_handle|planet_pin_1'''\n    pairs=[]\n    word=''\n    words=[]\n    for ch in raw+' ':\n        if ch==' ' or ch=='\\n':\n            if word!='':\n                words.append(word)\n                word=''\n        else: word=word+ch\n    for x in words:\n        a=''; b=''; bar=False\n        for ch in x:\n            if ch=='|': bar=True\n            elif bar: b=b+ch\n            else: a=a+ch\n        if [a,b] not in pairs and [b,a] not in pairs: pairs.append([a,b])\n    ideal={}\n    ideal['input_bearing|input_shaft']=['journal running fit represented by hinge',['relation/input_shaft_in_input_bearing'],['fit/input_bearing/input_bore/input_shaft/shaft_axis','pair/input_bearing/input_shaft']]\n    ideal['output_bearing|output_sleeve']=['journal running fit represented by hinge',['relation/output_sleeve_in_output_bearing'],['fit/output_bearing/output_bore/output_sleeve/outer_journal','pair/output_bearing/output_sleeve']]\n    ideal['input_shaft|sun_gear']=['declared press fit rigidly carried',['relation/sun_press_fit','transmission/input_shaft_to_sun'],['fit/input_shaft/sun_seat/sun_gear/shaft_bore','pair/input_shaft/sun_gear']]\n    ideal['carrier|output_sleeve']=['declared press fit rigidly carried',['relation/carrier_output_press_fit','transmission/carrier_to_output_sleeve'],['fit/output_sleeve/carrier_seat/carrier/output_bore','pair/carrier/output_sleeve']]\n    ideal['crank_arm|input_shaft']=['aligned fixed seat rigidly carried',['link/crank_arm','link/input_shaft'],['fit/input_shaft/crank_seat/crank_arm/drive_bore','pair/crank_arm/input_shaft']]\n    ideal['crank_arm|crank_handle']=['fixed handle rigidly carried',['link/crank_arm','link/crank_handle'],['pair/crank_arm/crank_handle']]\n    for i in range(1,5):\n        s=str(i)\n        ideal['planet_'+s+'|planet_pin_'+s]=['journal running fit represented by hinge',['relation/planet_'+s+'_journal'],['fit/planet_pin_'+s+'/pin_shaft/planet_'+s+'/pin_bore','pair/planet_'+s+'/planet_pin_'+s]]\n        ideal['carrier|planet_pin_'+s]=['interference pin seat rigidly carried',['link/carrier','link/planet_pin_'+s],['fit/carrier/pin_seat_'+s+'/planet_pin_'+s+'/pin_shaft','pair/carrier/planet_pin_'+s]]\n        ideal['planet_'+s+'|sun_gear']=['ideal external gear mesh replaces contact',['planetary_stage/four_planet_4to1_stage'],['fit/sun_gear/pitch_axis/planet_'+s+'/pitch_axis','pair/planet_'+s+'/sun_gear']]\n        ideal['fixed_ring_gear|planet_'+s]=['ideal internal gear mesh replaces contact',['planetary_stage/four_planet_4to1_stage'],['fit/fixed_ring_gear/ring_pitch_axis/planet_'+s+'/pitch_axis','pair/fixed_ring_gear/planet_'+s]]\n    contacts=[]\n    for p in pairs:\n        k=p[0]+'|'+p[1]; kr=p[1]+'|'+p[0]\n        if k in ideal: q=ideal[k]\n        elif kr in ideal: q=ideal[kr]\n        else: q=['measured positive separation or disjoint AABB extent: exact collision-proxy false-contact risk with no contact function',['link/'+p[0],'link/'+p[1]],['pair/'+p[0]+'/'+p[1]]]\n        contacts.append({'pair':p,'action':'exclude','reason':q[0],'source_entity_ids':q[1],'fact_ids':q[2]})\n    cmap={'base':None,'input_bearing':None,'output_bearing':None,'fixed_ring_gear':None,'input_shaft':'input_shaft_hinge','sun_gear':'input_shaft_hinge','crank_arm':'input_shaft_hinge','crank_handle':'input_shaft_hinge','output_sleeve':'output_sleeve_hinge','carrier':'output_sleeve_hinge'}\n    for i in range(1,5):\n        cmap['planet_pin_'+str(i)]='output_sleeve_hinge'; cmap['planet_'+str(i)]='planet_'+str(i)+'_carrier_hinge'\n    out.topology_plan({'coordinate_map':cmap,'tree_edges':[['base','fixed structure'],['input_bearing','input_shaft'],['output_bearing','output_sleeve'],['output_sleeve','carrier'],['carrier','planet pins'],['planet pins','planets']],'closure_edges':[['input_shaft_hinge','output_sleeve_hinge'],['input_shaft_hinge','planet hinges']],'rigid_carried':['sun by input','carrier by sleeve','pins by carrier','crank by input'],'independent_coaxial':['input versus output','planet spin versus carrier'],'transmissions':['carrier=sun/4','planet_local=-3sun/4'],'contact_decisions':contacts,'support_ground':'base remains on ground','support_strategy':'fixed root; no support patch'})\n    out.body('base')\n    for b in ['input_bearing','output_bearing','ring_post_1','ring_post_2','ring_post_3','ring_post_4']: out.body(b,'base')\n    out.body('fixed_ring_gear','ring_post_1')\n    out.body('input_shaft','input_bearing'); out.joint('input_shaft','input_shaft_hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world')\n    out.body('sun_gear','input_shaft'); out.body('crank_arm','input_shaft'); out.body('crank_handle','crank_arm')\n    out.body('output_sleeve','output_bearing'); out.joint('output_sleeve','output_sleeve_hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world'); out.body('carrier','output_sleeve')\n    pp=[(16,0,0),(0,16,0),(-16,0,0),(0,-16,0)]\n    for i in range(1,5):\n        s=str(i); out.body('planet_pin_'+s,'carrier'); out.body('planet_'+s,'planet_pin_'+s); out.joint('planet_'+s,'planet_'+s+'_carrier_hinge',axis=(0,0,1),pos_mm=pp[i-1],frame='world')\n    out.joint_equality('planetary_carrier_ratio','input_shaft_hinge','output_sleeve_hinge',0.25,reason='fixed ring planetary ratio',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n    for i in range(1,5):\n        s=str(i); out.joint_equality('planet_'+s+'_mesh','input_shaft_hinge','planet_'+s+'_carrier_hinge',-0.75,reason='sun and ring mesh kinematics',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n    for c in contacts: out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n    nodes={'motion_joint/input_shaft_hinge':['input_shaft_hinge'],'motion_joint/output_sleeve_hinge':['output_sleeve_hinge'],'transmission/input_shaft_to_sun':['input_shaft_hinge'],'transmission/carrier_to_output_sleeve':['output_sleeve_hinge'],'planetary_stage/four_planet_4to1_stage':['planetary_carrier_ratio','planet_1_mesh','planet_2_mesh','planet_3_mesh','planet_4_mesh']}\n    for i in range(1,5): nodes['motion_joint/planet_'+str(i)+'_carrier_hinge']=['planet_'+str(i)+'_carrier_hinge']\n    for eid in facts['entity_ids']:\n        if eid in nodes: g=nodes[eid]\n        elif eid[:5]=='link/': g=[eid[5:]]\n        else: g=[]\n        if eid[:5]=='link/' or eid in nodes: act='emitted'\n        else: act='represented_by'\n        out.decision(eid,action=act,generated_nodes=g,reason='represented by selected topology, placement, fit, transmission, role, or emitted node',fact_ids=[eid])\n", 'expected_revision': 0})
