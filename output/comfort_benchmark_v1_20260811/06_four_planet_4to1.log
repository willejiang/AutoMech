bearing|planet_2 output_bearing|planet_2 crank_arm|planet_2 planet_2|ring_post_1 planet_2|ring_post_2 crank_handle|planet_2 base|planet_2 planet_3|planet_pin_2 planet_3|planet_pin_4 input_bearing|planet_3 output_bearing|planet_3 crank_arm|planet_3 planet_3|ring_post_2 planet_3|ring_post_3 base|planet_3 planet_4|planet_pin_3 planet_4|planet_pin_1 input_bearing|planet_4 output_bearing|planet_4 crank_arm|planet_4 planet_4|ring_post_3 planet_4|ring_post_4 crank_handle|planet_4 base|planet_4 fixed_ring_gear|planet_pin_1 crank_arm|planet_pin_1 fixed_ring_gear|planet_pin_2 fixed_ring_gear|planet_pin_3 fixed_ring_gear|planet_pin_4 crank_arm|crank_handle crank_arm|fixed_ring_gear crank_arm|planet_pin_2 crank_arm|planet_pin_3 crank_arm|planet_pin_4 crank_arm|output_sleeve crank_handle|planet_pin_1'''\n    pairs = []\n    for x in raw.split():\n        p = x.split('|')\n        if p not in pairs and [p[1],p[0]] not in pairs:\n            pairs.append(p)\n    ideal = {}\n    ideal['input_bearing|input_shaft'] = ['journal running fit is represented by input_shaft_hinge', ['relation/input_shaft_in_input_bearing'], ['fit/input_bearing/input_bore/input_shaft/shaft_axis','pair/input_bearing/input_shaft']]\n    ideal['output_bearing|output_sleeve'] = ['journal running fit is represented by output_sleeve_hinge', ['relation/output_sleeve_in_output_bearing'], ['fit/output_bearing/output_bore/output_sleeve/outer_journal','pair/output_bearing/output_sleeve']]\n    ideal['input_shaft|sun_gear'] = ['declared press fit is rigidly carried on the input coordinate', ['relation/sun_press_fit','transmission/input_shaft_to_sun'], ['fit/input_shaft/sun_seat/sun_gear/shaft_bore','pair/input_shaft/sun_gear']]\n    ideal['carrier|output_sleeve'] = ['declared press fit is rigidly carried on the output coordinate', ['relation/carrier_output_press_fit','transmission/carrier_to_output_sleeve'], ['fit/output_sleeve/carrier_seat/carrier/output_bore','pair/carrier/output_sleeve']]\n    ideal['crank_arm|input_shaft'] = ['measured aligned interference seat is rigidly carried on the input coordinate', ['link/crank_arm','link/input_shaft'], ['fit/input_shaft/crank_seat/crank_arm/drive_bore','pair/crank_arm/input_shaft']]\n    ideal['crank_arm|crank_handle'] = ['fixed handle is rigidly carried by the crank arm', ['link/crank_arm','link/crank_handle'], ['pair/crank_arm/crank_handle']]\n    for i in range(1,5):\n        ideal['planet_'+str(i)+'|planet_pin_'+str(i)] = ['journal running fit is represented by the planet hinge', ['relation/planet_'+str(i)+'_journal'], ['fit/planet_pin_'+str(i)+'/pin_shaft/planet_'+str(i)+'/pin_bore','pair/planet_'+str(i)+'/planet_pin_'+str(i)]]\n        ideal['carrier|planet_pin_'+str(i)] = ['measured interference pin seat is rigidly carried by the carrier', ['link/carrier','link/planet_pin_'+str(i)], ['fit/carrier/pin_seat_'+str(i)+'/planet_pin_'+str(i)+'/pin_shaft','pair/carrier/planet_pin_'+str(i)]]\n        ideal['planet_'+str(i)+'|sun_gear'] = ['ideal external planetary tooth mesh replaces contact', ['planetary_stage/four_planet_4to1_stage'], ['fit/sun_gear/pitch_axis/planet_'+str(i)+'/pitch_axis','pair/planet_'+str(i)+'/sun_gear']]\n        ideal['fixed_ring_gear|planet_'+str(i)] = ['ideal internal planetary tooth mesh replaces contact', ['planetary_stage/four_planet_4to1_stage'], ['fit/fixed_ring_gear/ring_pitch_axis/planet_'+str(i)+'/pitch_axis','pair/fixed_ring_gear/planet_'+str(i)]]\n    contacts = []\n    for p in pairs:\n        k = p[0]+'|'+p[1]\n        kr = p[1]+'|'+p[0]\n        q = ideal.get(k, ideal.get(kr))\n        if q:\n            reason, src, fids = q\n        else:\n            reason = 'measured real-mesh separation or a disjoint AABB overlap extent shows no solid contact; no contact-dependent function is authored, so this exact collision-proxy risk is excluded'\n            src = ['link/'+p[0], 'link/'+p[1]]\n            fids = ['pair/'+p[0]+'/'+p[1]]\n        contacts.append({'pair':p,'action':'exclude','reason':reason,'source_entity_ids':src,'fact_ids':fids})\n    cmap = {'base':None,'input_bearing':None,'output_bearing':None,'fixed_ring_gear':None,'input_shaft':'input_shaft_hinge','sun_gear':'input_shaft_hinge','crank_arm':'input_shaft_hinge','crank_handle':'input_shaft_hinge','output_sleeve':'output_sleeve_hinge','carrier':'output_sleeve_hinge'}\n    for i in range(1,5):\n        cmap['planet_pin_'+str(i)] = 'output_sleeve_hinge'\n        cmap['planet_'+str(i)] = 'planet_'+str(i)+'_carrier_hinge'\n    plan = {'coordinate_map':cmap,'tree_edges':[['base','input_bearing'],['base','output_bearing'],['input_bearing','input_shaft'],['input_shaft','sun_gear'],['input_shaft','crank_arm'],['crank_arm','crank_handle'],['output_bearing','output_sleeve'],['output_sleeve','carrier']], 'closure_edges':[['input_shaft_hinge','output_sleeve_hinge','ratio 0.25'],['input_shaft_hinge','planet hinges','ratio -0.75']], 'rigid_carried':['sun_gear by input_shaft','carrier by output_sleeve','planet pins by carrier','crank assembly by input_shaft'], 'independent_coaxial':['input_shaft versus output_sleeve/carrier before planetary equality','each planet spin relative to carrier'], 'transmissions':['input_shaft and sun share one coordinate','output_sleeve and carrier share one coordinate','fixed-ring planetary: carrier=0.25 sun, planet_local=-0.75 sun'], 'contact_decisions':contacts, 'support_ground':'base rests on the global plane and remains ground-collidable', 'support_strategy':'normal model has a fixed base/root; the gravity support probe needs no topology alteration'}\n    out.topology_plan(plan)\n    out.body('base')\n    for b in ['input_bearing','output_bearing','ring_post_1','ring_post_2','ring_post_3','ring_post_4']:\n        out.body(b,'base')\n    out.body('fixed_ring_gear','ring_post_1')\n    out.body('input_shaft','input_bearing')\n    out.joint('input_shaft','input_shaft_hinge',kind='hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world')\n    out.body('sun_gear','input_shaft')\n    out.body('crank_arm','input_shaft')\n    out.body('crank_handle','crank_arm')\n    out.body('output_sleeve','output_bearing')\n    out.joint('output_sleeve','output_sleeve_hinge',kind='hinge',axis=(0,0,1),pos_mm=(0,0,0),frame='world')\n    out.body('carrier','output_sleeve')\n    for i in range(1,5):\n        out.body('planet_pin_'+str(i),'carrier')\n        out.body('planet_'+str(i),'planet_pin_'+str(i))\n        pos = [(16,0,0),(0,16,0),(-16,0,0),(0,-16,0)][i-1]\n        out.joint('planet_'+str(i),'planet_'+str(i)+'_carrier_hinge',kind='hinge',axis=(0,0,1),pos_mm=pos,frame='world')\n    out.joint_equality('planetary_carrier_ratio','input_shaft_hinge','output_sleeve_hinge',0.25,reason='fixed 48-tooth ring and 16-tooth sun give carrier = sun/4',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n    for i in range(1,5):\n        out.joint_equality('planet_'+str(i)+'_mesh','input_shaft_hinge','planet_'+str(i)+'_carrier_hinge',-0.75,reason='sun and fixed-ring meshes give local planet spin = -3/4 sun',sources=['planetary_stage/four_planet_4to1_stage'],fact_ids=['planetary_stage/four_planet_4to1_stage'])\n    for c in contacts:\n        out.exclude(c['pair'][0],c['pair'][1],c['reason'],c['source_entity_ids'],c['fact_ids'])\n    nodes = {'motion_joint/input_shaft_hinge':['input_shaft_hinge'],'motion_joint/output_sleeve_hinge':['output_sleeve_hinge'],'transmission/input_shaft_to_sun':['input_shaft_hinge'],'transmission/carrier_to_output_sleeve':['output_sleeve_hinge'],'planetary_stage/four_planet_4to1_stage':['planetary_carrier_ratio','planet_1_mesh','planet_2_mesh','planet_3_mesh','planet_4_mesh']}\n    for i in range(1,5):\n        nodes['motion_joint/planet_'+str(i)+'_carrier_hinge']=['planet_'+str(i)+'_carrier_hinge']\n    for eid in facts['entity_ids']:\n        g = nodes.get(eid, [eid[5:]] if eid[:5]=='link/' else [])\n        action = 'emitted' if eid[:5]=='link/' or eid in nodes else 'represented_by'\n        out.decision(eid,action=action,generated_nodes=g,reason='emitted directly or represented by the selected rigid-carrying tree, authored coordinate, placement, transmission, or role',fact_ids=[eid])\n", 'expected_revision': 0})
