# LLM endpoint for scenario_designer.py / strategy_selector.py / analyze.py.
# OpenAI-compatible gateway. Like cadam, all providers route through one gateway
# URL using a "provider/model" id, so you pick the VLM by changing the deployment.
#
# (A) Any OpenAI-compatible LLM gateway (multi-provider) — set the model you want:
#   AZURE_OPENAI_ENDPOINT=http://<gateway-host>:8313/v1
#   AZURE_OPENAI_API_KEY=<gateway-key>
#   AZURE_VLM_DEPLOYMENT=anthropic/claude-opus-4.8   # or openai/gpt-5.4, google/gemini-3.1-pro-preview
#
# (B) Azure OpenAI directly:
#   AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
#   AZURE_OPENAI_API_KEY=__PUT_KEY_HERE__
#   AZURE_VLM_DEPLOYMENT=gpt-5.4
#
# Copy to .env (gitignored) and fill in. NEVER commit a real key.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_VLM_DEPLOYMENT=anthropic/claude-opus-4.8
